local freePart = nil
local function setFreecam(on)
	freeOn = on
	local cam = workspace.CurrentCamera
	if on then
		if freePart then pcall(function() freePart:Destroy() end) end
		freePart = Instance.new("Part")
		freePart.Name = "_freecam"
		freePart.Size = Vector3.new(1, 1, 1)
		freePart.Transparency = 1
		freePart.CanCollide = false
		freePart.Anchored = true
		freePart.CFrame = (cam and cam.CFrame) or CFrame.new(0, 20, 0)
		freePart.Parent = workspace
		if cam then pcall(function() cam.CameraSubject = freePart end) end
		log("freecam on: WASD + Space/Shift")
		WGT.spawn(function()
			while WGT.isAlive() and freeOn and freePart and freePart.Parent do
				local c2 = workspace.CurrentCamera
				if c2 then
					local mv = Vector3.zero
					if UIS:IsKeyDown(Enum.KeyCode.W) then mv = mv + c2.CFrame.LookVector end
					if UIS:IsKeyDown(Enum.KeyCode.S) then mv = mv - c2.CFrame.LookVector end
					if UIS:IsKeyDown(Enum.KeyCode.A) then mv = mv - c2.CFrame.RightVector end
					if UIS:IsKeyDown(Enum.KeyCode.D) then mv = mv + c2.CFrame.RightVector end
					if UIS:IsKeyDown(Enum.KeyCode.Space) then mv = mv + Vector3.new(0, 1, 0) end
					if UIS:IsKeyDown(Enum.KeyCode.LeftShift) then mv = mv - Vector3.new(0, 1, 0) end
					if mv.Magnitude > 0 then
						freePart.CFrame = freePart.CFrame + mv.Unit * 3
					end
				end
				task.wait(0.05)
			end
		end)
	else
		if freePart then pcall(function() freePart:Destroy() end) end
		freePart = nil
		local mh = plr.Character and plr.Character:FindFirstChildOfClass("Humanoid")
		if mh then pcall(function() workspace.CurrentCamera.CameraSubject = mh end) end
		log("freecam off")
	end
end
