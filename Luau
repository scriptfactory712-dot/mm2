		for n, c in pairs(formCells) do
			if c.img and c.img.Parent then
				c.img.BackgroundColor3 = (curForm == n) and ACC or BTN
			end
		end
	end
	for _, name in ipairs(FORM_ORDER) do
		local f = FORMS[name]
		local cell = Instance.new("Frame")
		cell.BackgroundTransparency = 1
		cell.Parent = formGrid
		if f and f.pic then
			local img = Instance.new("ImageButton")
			img.Size = UDim2.new(0, 64, 0, 64)
			img.Position = UDim2.new(0.5, -32, 0, 0)
			img.BackgroundColor3 = BTN
			img.BorderSizePixel = 0
			img.Image = "rbxthumb://type=Asset&id=" .. tostring(f.pic) .. "&w=150&h=150"
			img.Parent = cell
			local fcc = Instance.new("UICorner") fcc.CornerRadius = UDim.new(0, 8) fcc.Parent = img
			local nm = Instance.new("TextLabel")
			nm.Size = UDim2.new(1, 0, 0, 22)
			nm.Position = UDim2.new(0, 0, 0, 66)
			nm.BackgroundTransparency = 1
			nm.Font = Enum.Font.Code
			nm.TextSize = 11
			nm.TextColor3 = TXT
			nm.TextTruncate = Enum.TextTruncate.AtEnd
			nm.Text = name
			nm.Parent = cell
			img.MouseButton1Click:Connect(function() applyForm(name) end)
			formCells[name] = {img = img}
		else
			local b = Instance.new("TextButton")
			b.Size = UDim2.new(1, 0, 0, 88)
			b.BackgroundColor3 = BTN
			b.BorderSizePixel = 0
			b.Font = Enum.Font.Code
			b.TextSize = 12
			b.TextColor3 = TXT
			b.TextWrapped = true
			b.Text = name
			b.Parent = cell
			local fcc = Instance.new("UICorner") fcc.CornerRadius = UDim.new(0, 8) fcc.Parent = b
			b.MouseButton1Click:Connect(function() applyForm(name) end)
			formCells[name] = {img = b}
		end
	end
	btn(PG.transform, "Detransform", function() revertForm() refreshForms() end)
	WGT.spawn(function()
		while WGT.isAlive() do
			if curForm and FORMS[curForm] then
				pcall(function()
					local hum = plr.Character and plr.Character:FindFirstChildOfClass("Humanoid")
					if hum and hum.Health > 0 then
						hum.WalkSpeed = FORMS[curForm].ws
						hum.JumpPower = FORMS[curForm].jp
						hum.UseJumpPower = true
					end
				end)
				task.wait(0.25)
			else
				task.wait(0.5)
			end
		end
	end)
	keep(plr.CharacterAdded:Connect(function()
		if curForm then
			task.wait(1.5)
			if curForm and FORMS[curForm] then
				local f = FORMS[curForm]
				pcall(function() workspace.CurrentCamera.FieldOfView = f.fov end)
				savedLook = {}
				buildAura(f)
				applyLook(f)
				log(curForm .. " re-applied")
			end
		end
	end))
	WGT.onUnload(function()
		pcall(function() revertForm(true) end)
	end)
	refreshForms()
end
