-- Anti-fling v4 (soft): БЕЗ якоря — двигаться можно всегда.
-- Тяжёлое тело + гашение скорости всех частей каждый кадр + возврат на
-- сейв только при жёстком срыве (>25 стадов за раз). Упреждение по спиннерам
-- рядом — только варн и превентивное гашение, без заморозки.
-- Всё состояние живёт во фрейме функции ради лимита регистров чанка.
local function initAntiFling()
local lastSafePos = nil
local lastSafeT = 0
local holdUntil = 0
local weAnchored = false
local savedPP = nil
local hotFrames = 0
local lastLogT = 0
local warnedName = nil
local function zeroAll(c)
	for _, part in pairs(c:GetDescendants()) do
		if part:IsA("BasePart") then
			part.AssemblyLinearVelocity = Vector3.zero
			part.AssemblyAngularVelocity = Vector3.zero
			part.Velocity = Vector3.zero
			part.RotVelocity = Vector3.zero
		end
	end
end
local function antiFlingDensity(on)
	if on and not WGT.isAlive() then return end
	local hrp = plr.Character and plr.Character:FindFirstChild("HumanoidRootPart")
	if on then
		if hrp then
			savedPP = {part = hrp, value = hrp.CustomPhysicalProperties}
			WGT.remember(hrp, "Anchored")
			hrp.CustomPhysicalProperties = PhysicalProperties.new(100, 0.3, 0.5)
		end
	else
		if savedPP then
			pcall(function() savedPP.part.CustomPhysicalProperties = savedPP.value end)
			savedPP = nil
		end
		if hrp and weAnchored then
			hrp.Anchored = false
			weAnchored = false
		end
	end
end
keep(plr.CharacterAdded:Connect(function()
	if antiFling then
		task.wait(1)
		pcall(function() antiFlingDensity(true) end)
	end
end))
keep(RS.Heartbeat:Connect(function()
	if not antiFling or not WGT.isAlive() then return end
	pcall(function()
		local ch = plr.Character
		local hrp = ch and ch:FindFirstChild("HumanoidRootPart")
		local hum = ch and ch:FindFirstChildOfClass("Humanoid")
		if not hrp or not hum or hum.Health <= 0 then hotFrames = 0 return end
		-- пропуск защиты только на 0.12с после реального шага FPos (окно узкое!)
		local now = os.clock()
		if now < (WGT.flingGrace or 0) then return end
		if flyOn or hum.PlatformStand or hiddenfling or flingTouchOn then hotFrames = 0 return end -- свой полёт/флинг - не мешаем
		-- 1) упреждение: рядом крутится спиннер (классическая подготовка флинга)
		local danger, dn = nil, nil
		for _, p in pairs(Players:GetPlayers()) do
			if p ~= plr and p.Character then
				local th = p.Character:FindFirstChild("HumanoidRootPart")
				local hu = p.Character:FindFirstChildOfClass("Humanoid")
				if th and hu and hu.Health > 0 then
					if th.AssemblyAngularVelocity.Magnitude > 60 or th.AssemblyLinearVelocity.Magnitude > 350 then
						local dd = (hrp.Position - th.Position).Magnitude
						if dd < 18 then danger, dn = p, dd break end
					end
				end
			end
		end
		-- 2) своё состояние: максимум по ВСЕМ частям, флинг крутит не только HRP
		local lv, av = 0, 0
		for _, part in pairs(ch:GetDescendants()) do
			if part:IsA("BasePart") then
				local l = part.AssemblyLinearVelocity.Magnitude
				local a = part.AssemblyAngularVelocity.Magnitude
				if l > lv then lv = l end
				if a > av then av = a end
			end
		end
		local hot = lv > 350 or av > 60
		if hot then hotFrames += 1 else hotFrames = 0 end
		if danger and dn < 12 then
			-- спиннер рядом: варн + превентивно гасим, но НЕ якорим
			if warnedName ~= danger.Name or now - lastLogT > 5 then
				warnedName = danger.Name
				lastLogT = now
				log("flinger near: " .. danger.Name)
			end
			zeroAll(ch)
		end
		if hot and hotFrames >= 2 then
			zeroAll(ch)
			-- жёсткий срыв (откинуло далеко за раз) — вернуть на сейв,
			-- обычное скольжение просто гасим, движение не трогаем
			if lastSafePos and now - lastSafeT < 10 and (hrp.Position - lastSafePos.Position).Magnitude > 25 then
				local oldCF = hrp.CFrame
				hrp.CFrame = CFrame.new(lastSafePos.Position + Vector3.new(0, 1, 0)) * (oldCF - oldCF.Position)
			end
			if now - lastLogT > 3 then lastLogT = now log("fling blocked") end
		elseif lv < 250 and av < 40 then
			lastSafePos = hrp.CFrame
			lastSafeT = now
		end
	end)
end))
WGT.antiFlingDensity = antiFlingDensity
WGT.onUnload(function() antiFlingDensity(false) end)
