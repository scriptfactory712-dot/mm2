							h.Transparency = 1
						end)
					end
				end
			end
		end
		if f.hair then
			for _, d in pairs(ch:GetDescendants()) do
				if d:IsA("Accessory") and d.Name ~= "_FormFx" then
					local h = d:FindFirstChild("Handle")
					if h and h:IsA("BasePart") then
						pcall(function()
							saveLook(h, "Color", h.Color)
							h.Color = f.hair
						end)
					end
				end
			end
		end
		if f.faceT then
			local head = ch:FindFirstChild("Head")
			local fc = head and (head:FindFirstChildOfClass("Decal") or head:FindFirstChild("face"))
			if fc then
				pcall(function()
					saveLook(fc, "Texture", fc.Texture)
					fc.Texture = f.faceT
				end)
			end
		end
		local ids = {}
		if f.hatId then table.insert(ids, f.hatId) end
		if f.faceAcc then table.insert(ids, f.faceAcc) end
		if type(f.extras) == "table" then
