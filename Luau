WGT.onUnload(function()
	bright, noFogOn, noShadowOn, noclip, espOn = false, false, false, false, false
	WGT.flingGen = (WGT.flingGen or 0) + 1
	WGT.flingGrace = 0
	WGT.sheriffHunt = false
	aimOn, forcedFP, autoReconnect = false, false, false
	tracersOn, boxOn, dotOn, arrowOn, gunV, coinV = false, false, false, false, false, false
	gunTracerOn, shakeOff, antiFling = false, false, false
	killAura, grabGun, huntSheriff, avoidMurder, discoOn = false, false, false, false, false
	troll.jerk, troll.hump, troll.orbit = false, false, false
	local ch = plr.Character
	local shoulder = jerkShoulder(ch)
	if shoulder then shoulder.Transform = CFrame.new() end
	local tool = ch and ch:FindFirstChild("_JerkTool")
	if tool then tool:Destroy() end
	-- Камера: возврат даже если Subject живой (spectate/freecam/forcedFP).
	-- Иначе после shutdown через верхнюю кнопку Unload камера висит.
	-- Только живой гуманоид: труп давал зависшую камеру.
	pcall(function()
		local cam = workspace.CurrentCamera
		local myHum = ch and ch:FindFirstChildOfClass("Humanoid")
		if cam and myHum and myHum.Health > 0 then cam.CameraSubject = myHum end
		plr.CameraMode = Enum.CameraMode.Classic
		if myHum then myHum.CameraOffset = Vector3.zero end
		local fp = workspace:FindFirstChild("_freecam")
		if fp then fp:Destroy() end
	end)
end)
local function unload()
	WGT.shutdown()
	pcall(function()
		-- Камера чинилась только если Subject мертвый. Если юзер вышел
		-- в spectate / freecam / forcedFP (aim) на живом Subject -
		-- камера оставалась висеть на чужом персе/парте.
		-- Теперь всегда возвращаем на своего хуманоида (только живого).
		local cam = workspace.CurrentCamera
		local myHum = plr.Character and plr.Character:FindFirstChildOfClass("Humanoid")
		if cam and myHum and myHum.Health > 0 then
			cam.CameraSubject = myHum
		end
		pcall(function() plr.CameraMode = Enum.CameraMode.Classic end)
		if myHum then pcall(function() myHum.CameraOffset = Vector3.zero end) end
		local fp = workspace:FindFirstChild("_freecam")
		if fp then pcall(function() fp:Destroy() end) end
	end)
end

-- Round roles reveal: объявляем мардера/шерифа в начале раунда из серверных ролей
WGT.spawn(function()
	while WGT.isAlive() do
		pcall(function()
			WGT.mm2.refresh()
			local roles = WGT.mm2.roles
			if type(roles) ~= "table" or next(roles) == nil then
				WGT.roundMurder = nil
				return
			end
			local m, s, h = nil, nil, nil
			for name, entry in pairs(roles) do
				if type(entry) == "table" and not entry.Killed and not entry.Dead then
					if entry.Role == "Murderer" then m = name
					elseif entry.Role == "Sheriff" then s = name
					elseif entry.Role == "Hero" then h = name end
				end
			end
			if m and m ~= WGT.roundMurder then
				WGT.roundMurder = m
				log("ROUND murder: " .. m .. (s and (" | sheriff: " .. s) or "") .. (h and (" | hero: " .. h) or ""))
			end
		end)
		task.wait(2)
	end
end)

