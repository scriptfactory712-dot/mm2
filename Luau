WGT.uiOwner = function(parentFrame)
	local current = parentFrame
	while current do
		if WGT.pageTabs[current] then return WGT.pageTabs[current] end
		current = current.Parent
	end
	error("UI container is not attached to a WindUI tab", 2)
end
	WGT.mount = function(element, parentFrame)
	if element.ElementFrame and element.ElementFrame.Parent ~= parentFrame then element.ElementFrame.Parent = parentFrame end
	return element
end
WGT.setOpen = function(open)
	if not WGT.isAlive() then return end
