	-- TOUCH FLING: стоим волчком на месте — тронувший нас улетает, мы остаёмся.
	-- Якорь-точки: пеший шаг едет за нами, а если откинуло полётом — дёргает назад.
	KF.touch = false
	KF.touchConn = nil
	KF.setTouch = function(on)
		if on and KF.active then log("stop target fling first") return end
		KF.touch = on
		if KF.touchConn then pcall(function() KF.touchConn:Disconnect() end) KF.touchConn = nil end
		if on then
			flinging = true
			WGT.touchFling = true
			KF.touchPin = nil
			KF.touchChar = nil
			KF.touchSpin = 0
			KF.touchSavedWS = nil
			pcall(function()
				local hc = plr.Character and plr.Character:FindFirstChildOfClass("Humanoid")
				if hc then
					KF.touchSavedWS = hc.WalkSpeed
					if hc.WalkSpeed < 23 then hc.WalkSpeed = 23 end
				end
			end)
			KF.touchConn = RS.Heartbeat:Connect(function()
				if not KF.touch or not WGT.isAlive() then return end
				pcall(function()
					local c = plr.Character
					local h = c and c:FindFirstChildOfClass("Humanoid")
					local r = h and h.RootPart
					if not (r and r.Parent and h.Health > 0) then return end
					if KF.touchChar ~= c then KF.touchChar = c KF.touchPin = nil end
					if not KF.touchPin then KF.touchPin = r.Position end
					if h.WalkSpeed < 23 then pcall(function() h.WalkSpeed = 23 end) end
					WGT.flingGrace = os.clock() + 0.15
					KF.touchSpin += 120
					local cur = r.Position
					if (cur - KF.touchPin).Magnitude > 6 then
						r.CFrame = CFrame.new(KF.touchPin) * CFrame.Angles(0, math.rad(KF.touchSpin), 0)
					else
						KF.touchPin = cur
						r.CFrame = CFrame.new(cur) * CFrame.Angles(0, math.rad(KF.touchSpin), 0)
					end
					r.AssemblyAngularVelocity = Vector3.new(0, 30000, 0)
					-- не душим ходьбу: режем только избыток (полёт), обычную
					-- скорость (до 26) пропускаем, вертикаль гасим чтобы не взлетать
					local lv = r.AssemblyLinearVelocity
					local flat = Vector3.new(lv.X, 0, lv.Z)
					if flat.Magnitude > 26 then
						local k = 26 / flat.Magnitude
						flat = Vector3.new(flat.X * k, 0, flat.Z * k)
					end
					r.AssemblyLinearVelocity = flat
				end)
			end)
			keep(KF.touchConn)
			log("touch fling on: стой — кто тронет, улетит")
		else
			WGT.touchFling = false
			if not KF.active then flinging = false end
			WGT.flingGrace = 0
			pcall(function()
				local c = plr.Character
				local h = c and c:FindFirstChildOfClass("Humanoid")
				local r = h and h.RootPart
				if r and r.Parent then
					r.AssemblyAngularVelocity = Vector3.zero
					r.AssemblyLinearVelocity = Vector3.zero
				end
				if h and KF.touchSavedWS then h.WalkSpeed = KF.touchSavedWS end
			end)
			KF.touchSavedWS = nil
			log("touch fling off")
		end
		if KF.touchBtn and KF.touchBtn.Parent then
			KF.touchBtn.Text = on and "🌀 TOUCH FLING: ON" or "🌀 TOUCH FLING: OFF"
		end
	end
	KF.touchBtn = Instance.new("TextButton")
