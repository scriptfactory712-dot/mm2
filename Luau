-- Как только мардер СБЛИЖАЕТСЯ — телепорт на точку спавна.
-- Всё состояние — в WGT, регистры чанка не трогаем.
keep(RS.Heartbeat:Connect(function()
	if not antiMurder or not WGT.isAlive() then return end
	if flyOn or flinging or hiddenfling or flingTouchOn or coinFarm or autoXP then
		if WGT.amBoosted then
			WGT.amBoosted = false
			pcall(function()
				local h = plr.Character and plr.Character:FindFirstChildOfClass("Humanoid")
				if h then h:Move(Vector3.zero, false) end
			end)
		end
		return
	end
	local ch = plr.Character
	local hrp = ch and ch:FindFirstChild("HumanoidRootPart")
	local hum = ch and ch:FindFirstChildOfClass("Humanoid")
	if not (hrp and hum and hum.Health > 0) then return end
	if hum:GetState() == Enum.HumanoidStateType.Seated then return end
	if hum.PlatformStand then return end
	if hrp.Anchored and not frozen then return end
	if WGT.amHum ~= hum then
		WGT.amHum = hum
		WGT.amBoosted = false
	end
	local now = os.clock()
	-- скан мардера не чаще 2 раз/сек, цель кэшируем
	if now - (WGT.amScanT or -99) >= 0.5 then
		WGT.amScanT = now
		WGT.mm2.refresh()
		local m = nil
		if getRole(plr) ~= "murder" then
			if type(WGT.mm2.roles) == "table" then
				for name, entry in pairs(WGT.mm2.roles) do
					if type(entry) == "table" and entry.Role == "Murderer" and not entry.Killed and not entry.Dead then
						local cand = Players:FindFirstChild(name)
						if cand and cand ~= plr then m = cand break end
					end
				end
			end
			if not m then m = findMurderSheriff() end
			if m == plr then m = nil end
		end
		WGT.amTarget = m
	end
	local m = WGT.amTarget
	local tch = m and m.Parent and m.Character or nil
	local thum = tch and tch:FindFirstChildOfClass("Humanoid")
	local t = tch and tch:FindFirstChild("HumanoidRootPart")
	if not (m and tch and thum and thum.Health > 0 and t) then
		if m then WGT.amTarget = nil end
		WGT.amPrevD = nil
		if WGT.amBoosted then
			WGT.amBoosted = false
			pcall(function()
				local base = WGT.amBaseWalk or 16
				if WGT.slGet["walkspeed"] then base = WGT.slGet["walkspeed"]() or base end
				hum.WalkSpeed = base
				hum:Move(Vector3.zero, false)
			end)
		end
		return
	end
	if WGT.amLastName ~= m.Name then
		WGT.amLastName = m.Name
		log("murder: " .. m.Name)
	end
	local delta = hrp.Position - t.Position
	local d = delta.Magnitude
	if d >= antiMurderDist then
		if WGT.amBoosted then
			WGT.amBoosted = false
			pcall(function()
				local base = WGT.amBaseWalk or 16
				if WGT.slGet["walkspeed"] then base = WGT.slGet["walkspeed"]() or base end
				hum.WalkSpeed = base
				hum:Move(Vector3.zero, false)
			end)
		end
		return
	end
	-- v3: как только мардер СБЛИЖАЕТСЯ — телепорт на точку спавна
	local dt = now - (WGT.amPrevT or now)
	local rate = 0
	if dt > 0.0001 then rate = ((WGT.amPrevD or d) - d) / dt end
	WGT.amPrevD = d
	WGT.amPrevT = now
	local closing = rate > 3
	if not closing then
		pcall(function()
			local mv = t.AssemblyLinearVelocity
			if mv and mv.Magnitude > 4 then
				local toMe = hrp.Position - t.Position
				if toMe.Magnitude > 0.5 and mv.Unit:Dot(toMe.Unit) > 0.6 then closing = true end
			end
		end)
	end
	if closing and d < antiMurderDist then
		local spawn = WGT.amSpawn
		if spawn and now - (WGT.amSpawnTpCD or -99) >= 2 then
			local sp = spawn.Position
			if sp.Y > -20 and (sp - t.Position).Magnitude > 12 then
				hrp.CFrame = spawn
				hrp.AssemblyLinearVelocity = Vector3.zero
				hrp.AssemblyAngularVelocity = Vector3.zero
				WGT.flingGrace = now + 0.2
				WGT.amSpawnTpCD = now
				log("murder coming -> spawn")
			end
		end
	end
end))
