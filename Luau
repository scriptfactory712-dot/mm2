	if not avoidMurder then return false end
	local hrp = plr.Character and plr.Character:FindFirstChild("HumanoidRootPart")
	if not hrp then return false end
	local m = findMurderSheriff()
	if m == plr then return false end -- сам мардер: не флеим от самого себя
	local tch = m and m.Character
	local thrp = tch and tch:FindFirstChild("HumanoidRootPart")
	if not thrp then return false end
	local away = hrp.Position - thrp.Position
	local d = away.Magnitude
	if d > 25 then return false end
	if d < 0.5 then away = Vector3.new(0, 0, 1) else away = away.Unit end
	hrp.CFrame = CFrame.new(hrp.Position + away * 30 + Vector3.new(0, 3, 0))
