		if f.shirtId then
			local sh2 = ch:FindFirstChildOfClass("Shirt")
			local tpl = resolveWear(f.shirtId, "Shirt", "ShirtTemplate")
			if sh2 and tpl then
				pcall(function()
					saveLook(sh2, "ShirtTemplate", sh2.ShirtTemplate)
					sh2.ShirtTemplate = tpl
				end)
			end
