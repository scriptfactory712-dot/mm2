-- Выбор цвета (порт Window:AddColorPicker из main2).
-- Простая палитра HSV-слайдером + hex-поле: полноценный picker в нашем GUI не нужен.
local function picker(parent, text, def, cb)
	local c = def or Color3.fromRGB(255, 255, 255)
	local element
	local function set(value)
		if not WGT.isAlive() or typeof(value) ~= "Color3" then return false end
		if value == c then return true end
		c = value
		local ok, accepted = safe(cb, c)
		if element then element:Update(c) end
		return ok and accepted ~= false
	end
	element = WGT.uiOwner(parent):Colorpicker({Title = text, Default = c, Callback = function(value)
		WGT.spawn(function() if element and element.Default == value then set(value) end end)
	end})
	WGT.clGet[text] = function() return c end
	WGT.clSet[text] = set
	WGT.controls["C_" .. text] = element
	return WGT.mount(element, parent)
end
local function dropdown(parent, text, opts, def, cb)
	local list = opts or {}
	local value = table.find(list, def) and def or list[1]
	local element
	local function set(nextValue, force)
		if not WGT.isAlive() or not table.find(list, nextValue) then return false end
		if nextValue == value and not force then return true end
		value = nextValue
		local ok, accepted = safe(cb, value)
		if element and element.Value ~= value then element:Select(value) end
		return ok and accepted ~= false
	end
	element = WGT.uiOwner(parent):Dropdown({Title = text, Values = list, Value = value, Multi = false, AllowNone = false, Callback = function(nextValue)
		WGT.spawn(function() if element and element.Value == nextValue then set(nextValue, false) end end)
	end})
	WGT.ddGet[text] = function() return value end
	WGT.ddSet[text] = function(nextValue) return set(nextValue, true) end
	WGT.controls["D_" .. text] = element
	return WGT.mount(element, parent)
end

-- Мультивыбор (порт Window:AddToggleMultiSelect из main2):
-- клик по кнопке включает/выключает всё, список — отметка конкретных опций.
local function multisel(parent, text, opts, onToggle, onSelect)
	local list = opts or {}
	local sel = {}
	for _, o in ipairs(list) do sel[o] = false end
	toggle(parent, text, false, function(on) return onToggle(on, sel) end)
	local element = WGT.uiOwner(parent):Dropdown({Title = text .. " options", Values = list, Value = {}, Multi = true, AllowNone = true, Callback = function(values)
		if not WGT.isAlive() then return end
		local out = {}
		for _, choice in ipairs(values) do out[choice] = true end
		for choice in pairs(sel) do sel[choice] = out[choice] == true end
		safe(onSelect, out)
	end})
	return WGT.mount(element, parent)
end
