local function btn(parent, text, cb)
	local element = WGT.uiOwner(parent):Button({Title = text, Callback = function()
		if WGT.isAlive() then safe(cb) end
	end})
	WGT.controls["B_" .. text] = element
	return WGT.mount(element, parent)
end
local function toggle(parent, text, def, cb)
	local s = def or false
	local element
	local function set(value)
		if not WGT.isAlive() or type(value) ~= "boolean" then return false end
		if value == s then return true end
		local previous = s
		s = value
		local ok, accepted = safe(cb, s)
		if not ok or accepted == false then s = previous end
		if element then element:Set(s, false, true) end
		return ok and accepted ~= false
	end
	element = WGT.uiOwner(parent):Toggle({Title = text, Value = s, Callback = function(value)
		WGT.spawn(function()
			if element and element.Value == value then set(value) end
		end)
	end})
	WGT.tgGet[text] = function() return s end
	WGT.tgSet[text] = set
	WGT.controls["T_" .. text] = element
	return WGT.mount(element, parent)
end

-- widgets (programmer style, no fancy)
-- Раньше эти таблицы и cfgSave/cfgLoad были глобалами -> падали в _ENV скрипта.
-- Четыре отдельных таблицы (4 регистра) -> одна WGT (1 регистр): главный чанк
-- упирался в лимит Luau в 200 живых регистров, а запас нужен под новые фичи.
-- Реестр соединений: unload обязан отключить ВСЁ, иначе скрипт продолжает
-- крутить RenderStepped/Heartbeat после выгрузки и падать на destroy-инстансах.
-- единая обёртка: pcall больше не глотает ошибки молча, а пишет их в лог + output
local function slider(parent, text, min, max, def, cb, step)
	min, max = min or 0, max or 100
	local v = math.clamp(def or min, min, max)
	local element
	local function apply(value, force)
		if not WGT.isAlive() or type(value) ~= "number" or value ~= value or math.abs(value) == math.huge then return false end
		value = math.clamp(value, min, max)
		local increment = step or 1
		value = min + math.floor((value - min) / increment + 0.5) * increment
		value = math.clamp(math.floor(value * 100 + 0.5) / 100, min, max)
		if value == v and not force then return true end
		v = value
		local ok, accepted = safe(cb, v)
		if element then element:Set(v) end
		return ok and accepted ~= false
	end
	element = WGT.uiOwner(parent):Slider({Title = text, Step = step or 1, Value = {Min = min, Max = max, Default = v}, Callback = function(value)
		WGT.spawn(function()
			if element and element.Value.Default == value then apply(value, false) end
		end)
	end})
	WGT.slGet[text] = function() return v end
	WGT.slSet[text] = function(value) return apply(value, true) end
	WGT.controls["S_" .. text] = element
	return WGT.mount(element, parent)
end

