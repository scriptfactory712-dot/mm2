-- Invisible: прячет персонажа
-- Invisible v4: настоящий FE-инвиз как в том скрипте (HRP-swap).
-- Как работает: тело уносится далеко вверх (сервер видит нас там),
-- корень клонируется, оригинал удаляется, клон возвращается назад.
-- Сервер остаётся с бескорневым телом в небе и больше не двигает нас
-- в глазах других — мы невидимы И ходим по карте.
-- Выключить обратно может только респаун: сервер тело уже потерял.
local function setInvisible(on)
	if on and not WGT.isAlive() then return end
	invisOn = on
	local ch = plr.Character
	if not ch then return end
	local hrp = ch:FindFirstChild("HumanoidRootPart")
	local hum = ch:FindFirstChildOfClass("Humanoid")
	if on then
		if hrp and hum and hum.Health > 0 then
			WGT.invisSpot = hrp.CFrame
		end
		invisSaved = {}
		for _, v in pairs(ch:GetDescendants()) do
			if v:IsA("BasePart") then
				invisSaved[v] = {v.Transparency, v.CastShadow}
				v.Transparency = 1
				pcall(function() v.CastShadow = false end)
			elseif v:IsA("Decal") then
				invisSaved[v] = {v.Transparency}
				v.Transparency = 1
			end
		end
		if hum then
			pcall(function()
				savedNameD = hum.NameDisplayDistance
				hum.NameDisplayDistance = 0
			end)
		end
		if hrp and hum and hum.Health > 0 then
			-- защита от цикла смерти: если прошлый своп убил (респавн
			-- меньше 8с назад) — только визуал, без свопа
			if os.clock() - (WGT.invisSwapT or -99) < 8 then
				log("invisible on (visual only: swap killed last time)")
				return
			end
			pcall(function()
				local c = plr.Character
				local h = c and c:FindFirstChild("HumanoidRootPart")
				if not h then return end
				local spotCF = WGT.invisSpot or h.CFrame
				c:MoveTo(h.Position + Vector3.new(0, 100000, 0))
				task.wait(0.25)
				local clone = h:Clone()
				task.wait(0.15)
				h:Destroy()
				clone.Parent = c
				c:MoveTo(spotCF.Position)
				WGT.invisSwapT = os.clock()
				WGT.flingGrace = os.clock() + 0.3
			end)
		end
		log("invisible on (FE swap)")
	else
		for v, sv in pairs(invisSaved) do
			pcall(function()
				if v and v.Parent then
					v.Transparency = sv[1]
					if sv[2] ~= nil and v:IsA("BasePart") then v.CastShadow = sv[2] end
				end
			end)
		end
		invisSaved = {}
		if hum then
			pcall(function() hum.NameDisplayDistance = savedNameD end)
		end
		WGT.invisSpot = nil
		-- видимость возвращает только респаун: клон серверу не принадлежит
		log("invisible off: respawning...")
		pcall(function() ch:BreakJoints() end)
	end
end
