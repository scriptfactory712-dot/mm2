	local function attachHat(id, scale)
		local ch = plr.Character
		local head = ch and ch:FindFirstChild("Head")
		if not head then return nil end
		local ok, objs = pcall(function() return game:GetObjects("rbxassetid://" .. tostring(id)) end)
		if not ok or type(objs) ~= "table" then log("hat load failed") return nil end
		local ret = nil
		for _, o in ipairs(objs) do
			local acc = nil
			if o:IsA("Accessory") then acc = o
			else pcall(function() acc = o:FindFirstChildWhichIsA("Accessory", true) end) end
			local handle = nil
			if acc then handle = acc:FindFirstChild("Handle") or acc:FindFirstChildWhichIsA("BasePart", true) end
			if acc and handle then
				handle.CanCollide = false
				pcall(function() handle.Massless = true end)
				if scale and scale ~= 1 then
					pcall(function() handle.Size = handle.Size * scale end)
				end
				local aha = nil
				for _, d in pairs(handle:GetChildren()) do
					if d:IsA("Attachment") then aha = d break end
				end
				if not aha then
					for _, d in pairs(acc:GetDescendants()) do
