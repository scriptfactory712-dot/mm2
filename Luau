local function validTarget(p)
	if not p or not p.Parent then return false end
	if not p.Character then return false end
	local hu = p.Character:FindFirstChildOfClass("Humanoid")
	if not hu or hu.Health <= 0 then return false end
	return p.Character:FindFirstChild("Head") ~= nil
end
-- Реквизиты рейказа живут на весь кадр: БЫЛО RaycastParams.new() на каждый
-- кадр, пока аимбот включён -> лишний объект в GC (4 рейказа/кадр и так дорого).
-- Один локал на чанк: лимит Luau в 200 регистров - жёсткий, скрипт не стартует.
-- Silent Aim (wall penetration): аим всегда идёт к голове цели,
-- сквозь стены. Raycast нужен ТОЛЬКО для визуального трейса.
local penParams = RaycastParams.new()
penParams.FilterType = Enum.RaycastFilterType.Exclude
local penTracers = {}
-- v3 caches: роли и стены кэшируем, иначе getRole+Raycast каждый кадр = лаги.
-- Всё во фрейме функции (не в чанке) - лимит 200 регистров чанка не трогаем.
local roleCache = {}
local wallCache = {}
local lastScan = 0
local scanTarget = nil
if WGT.aimPred == nil then WGT.aimPred = 0.15 end
if WGT.aimPart == nil then WGT.aimPart = "Head" end
keep(Players.PlayerRemoving:Connect(function(p) roleCache[p] = nil wallCache[p] = nil if WGT.aimLock == p then WGT.aimLock = nil end if scanTarget == p then scanTarget = nil end end))
local function roleCached(p, now)
	local e = roleCache[p]
	if e and now - e[1] < 0.5 then return e[2] end
	local r = getRole(p)
	roleCache[p] = {now, r}
	return r
end
local function wallClearCached(cam, headPos, targetP, now)
	if WGT.aimWall then return true end
	local c = wallCache[targetP]
	if c and now - c[1] < 0.15 then return c[2] end
	local clear = true
	local org = cam.CFrame.Position
	local ok, res = pcall(function() return workspace:Raycast(org, headPos - org, penParams) end)
	if ok and res and res.Instance then
		local m = res.Instance:FindFirstAncestorOfClass("Model")
		local hitP = m and Players:GetPlayerFromCharacter(m)
		if hitP ~= targetP then clear = false end
	end
	wallCache[targetP] = {now, clear}
	return clear
end
local function aimPartGet(char)
	local mode = WGT.aimPart or "Head"
	if mode == "Torso" then
		return char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso") or char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Head")
	elseif mode == "Closest" then
		local cam = workspace.CurrentCamera
		if not cam then return char:FindFirstChild("Head") end
		local best, bestD = nil, 1e9
		for _, n in ipairs({"Head", "UpperTorso", "HumanoidRootPart", "Torso"}) do
			local part = char:FindFirstChild(n)
			if part then
				local sp, vis = cam:WorldToViewportPoint(part.Position)
				if vis then
					local cx0, cy0 = cam.ViewportSize.X / 2, cam.ViewportSize.Y / 2
					local d2 = (sp.X - cx0) * (sp.X - cx0) + (sp.Y - cy0) * (sp.Y - cy0)
					if d2 < bestD then bestD = d2 best = part end
				end
			end
		end
		return best or char:FindFirstChild("Head")
	end
	return char:FindFirstChild("Head")
end
local function penTrace(cam, origin, targetPos, tp)
	local dir = targetPos - origin
	local res = workspace:Raycast(origin, dir, penParams)
	local wallHit = nil
	if res and res.Instance then
		local m = res.Instance:FindFirstAncestorOfClass("Model")
		local pl = m and Players:GetPlayerFromCharacter(m)
		if not pl then wallHit = res.Position end
	end
	local key = tostring(cam) .. ":" .. (tp and tp.Name or "nil")
	local ln = penTracers[key]
	if wallHit then
		if not ln then
			local ok, drawing = pcall(function() return Drawing.new("Line") end)
			if ok then ln = drawing penTracers[key] = ln end
		end
		if ln then
			local from, fromVisible = cam:WorldToViewportPoint(wallHit)
			local to, toVisible = cam:WorldToViewportPoint(targetPos)
			ln.From = Vector2.new(from.X, from.Y)
			ln.To = Vector2.new(to.X, to.Y)
			ln.Color = Color3.fromRGB(255, 50, 50)
			ln.Thickness = 1
			ln.Visible = fromVisible and toVisible
		end
	elseif ln then
		ln.Visible = false
	end
	return wallHit
end
-- Aimbot v3: sticky lock с проверкой стен + кэш ролей/стен + скоринг с дистанцией.
-- Скан целей не чаще 30 Гц (lastScan/scanTarget), доводка каждый кадр идёт
-- по закэшированной цели - меньше Raycast/GetChildren, выше FPS.
local function aimTarget()
	local cam = workspace.CurrentCamera
	if not cam then return nil end
	local now = os.clock()
	penParams.FilterDescendantsInstances = plr.Character and {plr.Character} or {}
	local cx, cy = cam.ViewportSize.X / 2, cam.ViewportSize.Y / 2
	local fov2 = aimFov * aimFov
	-- быстрый путь: скан не чаще 30 Гц, иначе отдаём кэш
	if now - lastScan < 0.033 then
		local c = scanTarget
		if c and validTarget(c) then
			local ch0 = c.Character
			local hd0 = ch0 and (ch0:FindFirstChild("Head") or ch0:FindFirstChild("HumanoidRootPart"))
			if hd0 then
				local sp0, vis0 = cam:WorldToViewportPoint(hd0.Position)
				if vis0 then
					local dx0, dy0 = sp0.X - cx, sp0.Y - cy
					if dx0 * dx0 + dy0 * dy0 <= fov2 * 1.96 then return c end
				end
			end
		end
		if c == nil then return nil end
	end
	lastScan = now
	local myRole = roleCached(plr, now)
	-- sticky lock: держим пока жива + в FOV x1.4 + (если стены важны) видна
	local lock = WGT.aimLock
	if lock and validTarget(lock) then
		local chL = lock.Character
		local hd0 = chL and (chL:FindFirstChild("Head") or chL:FindFirstChild("HumanoidRootPart"))
		if hd0 then
			local sp0, vis0 = cam:WorldToViewportPoint(hd0.Position)
			if vis0 then
				local dx0, dy0 = sp0.X - cx, sp0.Y - cy
				if dx0 * dx0 + dy0 * dy0 <= fov2 * 1.96 then
					if wallClearCached(cam, hd0.Position, lock, now) then
						scanTarget = lock
						return lock
					end
				end
			end
		end
	end
	local myHrp = plr.Character and plr.Character:FindFirstChild("HumanoidRootPart")
	local myPos = myHrp and myHrp.Position or cam.CFrame.Position
	local cands = {}
	for _, p in pairs(Players:GetPlayers()) do
		if p ~= plr and p.Character then
			local hu = p.Character:FindFirstChildOfClass("Humanoid")
			local hd = p.Character:FindFirstChild("Head")
			if hu and hu.Health > 0 and hd then
				local r = roleCached(p, now)
				local want = false
				if myRole == "murder" then want = (r ~= "murder")
				else want = (r == "murder") end
				if want then
					local sp, vis = cam:WorldToViewportPoint(hd.Position)
					if vis then
						local dx, dy = sp.X - cx, sp.Y - cy
						local d2 = dx * dx + dy * dy
						if d2 <= fov2 then
							-- скоринг: экранная дистанция + лёгкий штраф за дальность в 3D,
							-- чтобы из двух рядом с прицелом брался ближний
							local dist3 = (myPos - hd.Position).Magnitude
							local score = d2 + dist3 * dist3 * 0.02
							table.insert(cands, {p, score})
						end
					end
				end
			end
		end
	end
	if #cands == 0 then WGT.aimLock = nil scanTarget = nil return nil end
	table.sort(cands, function(a, b) return a[2] < b[2] end)
	local best = nil
	for i = 1, math.min(#cands, 3) do
		local p = cands[i][1]
		local chB = p.Character
		local hd = chB and (chB:FindFirstChild("Head") or chB:FindFirstChild("HumanoidRootPart"))
		if hd and wallClearCached(cam, hd.Position, p, now) then best = p break end
	end
	WGT.aimLock = best
	scanTarget = best
	return best
end
local function aimStep()
	for _, line in pairs(penTracers) do line.Visible = false end
	local now = os.clock()
	local dt = now - (WGT.aimDt or now)
	WGT.aimDt = now
	if dt < 0 then dt = 0 elseif dt > 0.05 then dt = 0.05 end
	local xh, xv = WGT.crossH, WGT.crossV
	if not aimOn or not WGT.isAlive() then
		for _, line in pairs(penTracers) do line.Visible = false end
		if fovCircle then fovCircle.Visible = false end
		if fovRing then fovRing.Visible = false end
		if WGT.aimLine then WGT.aimLine.Visible = false end
		if forcedFP then
			forcedFP = false
			pcall(function() plr.CameraMode = Enum.CameraMode.Classic end)
		end
		if xh and xv then
			local cv = false
			pcall(function() cv = WGT.tgGet["crosshair"] and WGT.tgGet["crosshair"]() end)
			xh.Visible = cv
			xv.Visible = cv
		end
		WGT.aimLock = nil
		aimState = 0
		return
	end
	local cam = workspace.CurrentCamera
	if not cam then return end
	-- v3: FP-чек не каждый кадр, а 4 раза/сек + кэш ролей. Было: полный
	-- перебор игроков с getRole() на каждый RenderStepped = просадки.
	local nearD = WGT.aimNearD
	if now - (WGT.aimFpTick or 0) >= 0.25 then
		WGT.aimFpTick = now
		local myRole = roleCached(plr, now)
		nearD = nil
		if myRole == "sheriff" or myRole == "murder" then
			pcall(function()
				local myHrp = plr.Character and plr.Character:FindFirstChild("HumanoidRootPart")
				if myHrp then
					local best = 1e9
					for _, p in pairs(Players:GetPlayers()) do
						if p ~= plr and p.Character then
							local hu = p.Character:FindFirstChildOfClass("Humanoid")
							local th = p.Character:FindFirstChild("HumanoidRootPart")
							if hu and hu.Health > 0 and th then
								local r = roleCached(p, now)
								if r == "murder" or r == "sheriff" then
									local d = (myHrp.Position - th.Position).Magnitude
									if d < best then best = d end
								end
							end
						end
					end
				end
				if best < 1e9 then nearD = best end
			end)
		end
		WGT.aimNearD = nearD
	end
	if nearD and nearD <= 20 then
		if not forcedFP then
			forcedFP = true
			pcall(function() plr.CameraMode = Enum.CameraMode.LockFirstPerson end)
		end
		local mh0 = plr.Character and plr.Character:FindFirstChildOfClass("Humanoid")
		if mh0 then pcall(function() mh0.CameraOffset = Vector3.zero end) end
	elseif forcedFP then
		forcedFP = false
		pcall(function() plr.CameraMode = Enum.CameraMode.Classic end)
	end
	if aimCircle then
		local c = fovCircleGet()
		if c then
			c.Visible = true
			c.Position = Vector2.new(cam.ViewportSize.X / 2, cam.ViewportSize.Y / 2)
			c.Radius = aimFov
		end
		if fovRing then
			fovRing.Visible = (c == nil)
			fovRing.Size = UDim2.new(0, aimFov * 2, 0, aimFov * 2)
		end
	else
		if fovCircle then fovCircle.Visible = false end
		if fovRing then fovRing.Visible = false end
	end
	if not WGT.aimLine then
		pcall(function()
			local L = Drawing.new("Line")
			L.Thickness = 1.5
			L.Color = Color3.fromRGB(60, 220, 90)
			L.Visible = false
			WGT.aimLine = L
		end)
	end
	local t = aimTarget()
	if t ~= loggedT then
		loggedT = t
		if t then log("lock: " .. t.Name) end
	end
	local cx, cy = cam.ViewportSize.X / 2, cam.ViewportSize.Y / 2
	if not t or not t.Character then
		aimState = math.max(0, aimState - dt / 0.1)
		if WGT.aimLine then WGT.aimLine.Visible = false end
		if xh and xv then
			xh.Visible = true
			xv.Visible = true
			xh.BackgroundColor3 = Color3.fromRGB(60, 220, 90)
			xv.BackgroundColor3 = Color3.fromRGB(60, 220, 90)
		end
		return
	end
	local part = t.Character and aimPartGet(t.Character) or nil
	local hum = t.Character and t.Character:FindFirstChildOfClass("Humanoid") or nil
	if not part or not hum or hum.Health <= 0 then
		aimState = math.max(0, aimState - dt / 0.1)
		return
	end
	aimState = math.min(1, aimState + dt / 0.12)
	-- v3 предикт: скорость цели * (база + поправка на дистанцию), кламп от флингов.
	-- База крутится слайдером "aim predict" (WGT.aimPred, дефолт 0.15).
	local ap = part.Position
	local dist3d = (cam.CFrame.Position - ap).Magnitude
	pcall(function()
		local hv = part.AssemblyLinearVelocity
		if hv and hv.Magnitude > 0.5 then
			local pred = WGT.aimPred or 0.15
			local extra = math.clamp(dist3d / 2000, 0, 0.12)
			local lead = hv * (pred + extra)
			local maxLead = math.clamp(dist3d * 0.15, 4, 12)
			if lead.Magnitude > maxLead then lead = lead.Unit * maxLead end
			ap = ap + lead
			if hv.Y < -30 then ap = ap + Vector3.new(0, (-hv.Y) * 0.02, 0) end
		end
	end)
	pcall(function() penTrace(cam, cam.CFrame.Position, ap, t) end)
	local sp, vis = cam:WorldToViewportPoint(ap)
	if not vis then return end
	local dx, dy = sp.X - cx, sp.Y - cy
	if dx ~= dx or dy ~= dy then return end
	local dist2 = dx * dx + dy * dy
	if dist2 > aimFov * aimFov then return end
	local mag = math.sqrt(dist2)
	local trigRad = WGT.trigRad or 18
	local inTrig = dist2 <= trigRad * trigRad
	-- v3 доводка: та же exp-формула для совместимости слайдеров, но:
	-- deadzone 1.0 вместо 1.5, кламп шага 120px/кадр против фликов,
	-- честное округление для отрицательных дельт (было смещение вниз).
	local k = 1 - math.exp(-aimSmooth * dt)
	local ramp = 0.25 + 0.75 * aimState
	local pull = math.clamp((aimPull / 25) * k * ramp, 0, 1)
	if mag < 20 then
		local kk = mag / 20
		if kk < 0.25 then kk = 0.25 end
		pull = pull * kk
	end
	if mag >= 1.0 and typeof(mousemoverel) == "function" then
		local fx, fy = dx * pull, dy * pull
		-- кламп шага: один кадр не уводит дальше 120px (анти-флик/шейк)
		local stepMag = math.sqrt(fx * fx + fy * fy)
		if stepMag > 120 then fx, fy = fx / stepMag * 120, fy / stepMag * 120 end
		local mx = fx >= 0 and math.floor(fx + 0.5) or math.ceil(fx - 0.5)
		local my = fy >= 0 and math.floor(fy + 0.5) or math.ceil(fy - 0.5)
		mx = math.clamp(mx, -cx, cx)
		my = math.clamp(my, -cy, cy)
		if mx ~= 0 or my ~= 0 then
			pcall(function() mousemoverel(mx, my) end)
		end
	elseif mag >= 1.0 then
		pcall(function()
			local cur = cam.CFrame
			cam.CFrame = cur:Lerp(CFrame.lookAt(cur.Position, ap), math.clamp(pull, 0.02, 1))
		end)
	end
	-- sheriff crosshair fix: свой прицел поверх игрового, красный = можно жать
	local col = inTrig and Color3.fromRGB(255, 60, 60) or Color3.fromRGB(60, 220, 90)
	if xh and xv then
		xh.Visible = true
		xv.Visible = true
		xh.BackgroundColor3 = col
		xv.BackgroundColor3 = col
	end
	if WGT.aimLine then
		WGT.aimLine.Visible = true
		WGT.aimLine.From = Vector2.new(cx, cy)
		WGT.aimLine.To = Vector2.new(sp.X, sp.Y)
		WGT.aimLine.Color = col
	end
	-- triggerbot v3: огонь только с ганом в руках + перепроверка стены в момент
	-- выстрела (иначе при aim ignore walls палил в стену впустую).
	if triggerOn and inTrig and aimState > 0.6 then
		if now - (WGT.trigCD or 0) >= 0.55 then
			local blocked = false
			if not WGT.aimWall then
				pcall(function()
					local org = cam.CFrame.Position
					local res = workspace:Raycast(org, ap - org, penParams)
					if res and res.Instance then
						local m = res.Instance:FindFirstAncestorOfClass("Model")
						local hitP = m and Players:GetPlayerFromCharacter(m)
						if hitP ~= t then blocked = true end
					end
				end)
			end
			if blocked then return end
			WGT.trigCD = now
			pcall(function()
				local ch = plr.Character
				if not ch then return end
				local gun = nil
				for _, tool in pairs(ch:GetChildren()) do
					if tool:IsA("Tool") then
						local n = string.lower(tool.Name)
						if string.find(n, "gun", 1, true) or string.find(n, "revolver", 1, true) then gun = tool break end
					end
				end
				if not gun then return end
				if typeof(mouse1click) == "function" then pcall(mouse1click)
				else pcall(function() gun:Activate() end) end
			end)
		end
	end
end
