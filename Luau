	-- ===== LUA FLING — Black & Green, вкладка Lua Fling =====
	-- Всё состояние в одной таблице KF: главный чанк упёрт в лимит 200 регистров,
	-- поэтому никаких новых локалов чанка кроме lay/pad/KF/selframe.
	local KF = { sel = {}, boxes = {}, avatars = {}, active = false, abort = false, bv = nil, oldPos = nil, fpdh = -500 }
	pcall(function() KF.fpdh = workspace.FallenPartsDestroyHeight end)

	KF.count = function()
		local c = 0
		for _ in pairs(KF.sel) do c += 1 end
		return c
	end

	KF.status = function()
		if not (KF.lbl and KF.lbl.Parent) then return end
		local c = KF.count()
		if KF.active then
			KF.lbl.Text = "🟢 ФЛИНГ АКТИВЕН: " .. c .. " целей"
			KF.lbl.TextColor3 = Color3.fromRGB(0, 255, 0)
		else
			KF.lbl.Text = "⚫ Выбрано: " .. c .. " целей"
			KF.lbl.TextColor3 = Color3.fromRGB(50, 200, 50)
		end
	end

	KF.notify = function(t, s, d)
		pcall(function()
			game:GetService("StarterGui"):SetCore("SendNotification", { Title = t, Text = s, Duration = d or 5 })
		end)
	end

	-- ОРИГИНАЛЬНАЯ ФУНКЦИЯ ФЛИНГА (SkidFling): FPos-осцилляция 9e7/9e8
	KF.fling = function(TargetPlayer)
		local Char = plr.Character
		local Hum = Char and Char:FindFirstChildOfClass("Humanoid")
		local Root = Hum and Hum.RootPart
		local TChar = TargetPlayer.Character
		if not TChar then return end
		local THum = TChar:FindFirstChildOfClass("Humanoid")
		local TRoot = THum and THum.RootPart
		local THead = TChar:FindFirstChild("Head")
		local Acc = TChar:FindFirstChildOfClass("Accessory")
		local Handle = Acc and Acc:FindFirstChild("Handle")
		if not (Char and Hum and Root) then KF.notify("Error", "Your character not ready", 2) return end
		if not THum or THum.Health <= 0 then return end
		if not TChar:FindFirstChildWhichIsA("BasePart") then return end
		if Root.Velocity.Magnitude < 50 then KF.oldPos = Root.CFrame end
		if THum.Sit then KF.notify("Error", TargetPlayer.Name .. " is sitting", 2) return end
		pcall(function()
			if THead then workspace.CurrentCamera.CameraSubject = THead
			elseif Handle then workspace.CurrentCamera.CameraSubject = Handle
			elseif TRoot then workspace.CurrentCamera.CameraSubject = THum end
		end)

		flinging = true
		local ff = Instance.new("ForceField")
		ff.Parent = Char

		local function FPos(bp, pos, ang)
			if not KF.active then return end
			WGT.flingGrace = os.clock() + 0.12
			Root.CFrame = CFrame.new(bp.Position) * pos * ang
			-- PrimaryPart может быть nil (тогда ошибка убивала бы FPos ДО строк скорости
			-- и цель не получала бы импульс вообще) — изолируем, скорость ставится всегда
			pcall(function() Char:SetPrimaryPartCFrame(CFrame.new(bp.Position) * pos * ang) end)
			Root.Velocity = Vector3.new(9e7, 9e7 * 10, 9e7)
			Root.RotVelocity = Vector3.new(9e8, 9e8, 9e8)
		end

		local function SFBasePart(bp)
			local tm = os.clock()
			local ang = 0
			local ticks, peakT, peakS, baseT = 0, 0, 0, 0
			pcall(function() baseT = bp.Velocity.Magnitude end)
			repeat
				if Root and THum and KF.active then
					if Hum.Health <= 0 then break end
					ticks += 1
					-- прямой импульс цели (свой рапорт: держится ли скорость на её HRP)
					pcall(function()
						local d = bp.Position - Root.Position
						if d.Magnitude < 0.5 then d = Vector3.new(0, 1, 0) end
						d = d.Unit
						bp.AssemblyLinearVelocity = d * 50000 + Vector3.new(0, 50000, 0)
						local tv = bp.Velocity.Magnitude
						if tv > peakT then peakT = tv end
						local sv = Root.Velocity.Magnitude
						if sv > peakS then peakS = sv end
					end)
					if bp.Velocity.Magnitude < 50 then
						ang += 100
						local md = THum.MoveDirection
						local vm = bp.Velocity.Magnitude / 1.25
						FPos(bp, CFrame.new(0, 1.5, 0) + md * vm, CFrame.Angles(math.rad(ang), 0, 0))
						task.wait()
						FPos(bp, CFrame.new(0, -1.5, 0) + md * vm, CFrame.Angles(math.rad(ang), 0, 0))
						task.wait()
						FPos(bp, CFrame.new(0, 1.5, 0) + md * vm, CFrame.Angles(math.rad(ang), 0, 0))
						task.wait()
						FPos(bp, CFrame.new(0, -1.5, 0) + md * vm, CFrame.Angles(math.rad(ang), 0, 0))
						task.wait()
						FPos(bp, CFrame.new(0, 1.5, 0) + md, CFrame.Angles(math.rad(ang), 0, 0))
						task.wait()
						FPos(bp, CFrame.new(0, -1.5, 0) + md, CFrame.Angles(math.rad(ang), 0, 0))
						task.wait()
					else
						local ws = THum.WalkSpeed
						FPos(bp, CFrame.new(0, 1.5, ws), CFrame.Angles(math.rad(90), 0, 0))
						task.wait()
						FPos(bp, CFrame.new(0, -1.5, -ws), CFrame.Angles(0, 0, 0))
						task.wait()
						FPos(bp, CFrame.new(0, 1.5, ws), CFrame.Angles(math.rad(90), 0, 0))
						task.wait()
						FPos(bp, CFrame.new(0, -1.5, 0), CFrame.Angles(math.rad(90), 0, 0))
						task.wait()
						FPos(bp, CFrame.new(0, -1.5, 0), CFrame.Angles(0, 0, 0))
						task.wait()
						FPos(bp, CFrame.new(0, -1.5, 0), CFrame.Angles(math.rad(90), 0, 0))
						task.wait()
						FPos(bp, CFrame.new(0, -1.5, 0), CFrame.Angles(0, 0, 0))
						task.wait()
					end
				else
					break
				end
			until os.clock() > tm + 2 or not KF.active
			return ticks, peakT, peakS, baseT
		end

		pcall(function() workspace.FallenPartsDestroyHeight = -1000000 end)
		local bv = Instance.new("BodyVelocity")
		bv.Parent = Root
		bv.Velocity = Vector3.new(0, 0, 0)
		bv.MaxForce = Vector3.new(9e9, 9e9, 9e9)
		KF.bv = bv
		pcall(function() Hum:SetStateEnabled(Enum.HumanoidStateType.Seated, false) end)
		local ft, fp, fs, fb = 0, 0, 0, 0
		pcall(function()
			if TRoot then ft, fp, fs, fb = SFBasePart(TRoot)
			elseif THead then ft, fp, fs, fb = SFBasePart(THead)
			elseif Handle then ft, fp, fs, fb = SFBasePart(Handle) end
		end)
		log(string.format("fling %s: ticks=%d base=%.0f peakTgt=%.0f peakSelf=%.0f", TargetPlayer.Name, ft, fb, fp, fs))
		pcall(function() bv:Destroy() end)
		KF.bv = nil
		pcall(function() Hum:SetStateEnabled(Enum.HumanoidStateType.Seated, true) end)
		pcall(function() if workspace.CurrentCamera then workspace.CurrentCamera.CameraSubject = Hum end end)

		-- возврат домой ТОЛЬКО при естественном финале; после СТОПа — стоим на месте
		-- якорь на время возврата: физика не дрейфует, прилёт точный
		if KF.oldPos and WGT.isAlive() and not KF.abort then
			pcall(function() Root.Anchored = true end)
			local guard = 0
			repeat
				guard += 1
				if guard > 120 or not WGT.isAlive() or KF.abort then break end
				pcall(function()
					Root.CFrame = KF.oldPos * CFrame.new(0, 0.5, 0)
					Char:SetPrimaryPartCFrame(KF.oldPos * CFrame.new(0, 0.5, 0))
					Hum:ChangeState(Enum.HumanoidStateType.GettingUp)
					for _, x in pairs(Char:GetChildren()) do
						if x:IsA("BasePart") then x.Velocity, x.RotVelocity = Vector3.new(), Vector3.new() end
					end
				end)
				task.wait()
			until (Root.Position - KF.oldPos.Position).Magnitude < 25
		end
		pcall(function() workspace.FallenPartsDestroyHeight = KF.fpdh end)
		pcall(function()
			Root.Anchored = false
			Root.AssemblyLinearVelocity = Vector3.zero
			Root.AssemblyAngularVelocity = Vector3.zero
			Root.Velocity = Vector3.zero
			Root.RotVelocity = Vector3.zero
		end)

		pcall(function() local c = plr.Character if c then local f = c:FindFirstChildOfClass("ForceField") if f then f:Destroy() end end end)
		WGT.flingGrace = 0
		pcall(function()
			local c = plr.Character
			if c then for _, x in pairs(c:GetChildren()) do
				if x:IsA("BasePart") then x.Velocity = Vector3.zero x.RotVelocity = Vector3.zero end
			end end
		end)
		flinging = false
		log("fling done: " .. TargetPlayer.Name)
	end

	-- OVERRIDE: НОРМАЛЬНЫЙ ФЛИНГ (замена SkidFling выше).
	-- Что было не так: deprecated Root.Velocity/RotVelocity, BodyVelocity со
	-- скоростью 0 душил спин, SetPrimaryPartCFrame падал при PrimaryPart=nil,
	-- прямая запись скорости в чужой bp (не реплицируется сервером, плацебо),
	-- камера дёргалась на цель, возврат домой — цикл на 120 тиков.
	-- Здесь: только Assembly* + fallback, без муверов, прилипание к цели,
	-- ранний выход при успехе (цель уже летит), возврат одним телепортом.
	KF.fling = function(TargetPlayer)
		if not (TargetPlayer and TargetPlayer.Parent and TargetPlayer ~= plr) then return end
		local Char = plr.Character
		local Hum = Char and Char:FindFirstChildOfClass("Humanoid")
		local Root = Hum and Hum.RootPart
		if not (Char and Hum and Root and Root.Parent) then return end
		if Hum.Health <= 0 then return end
		local TChar = TargetPlayer.Character
		local THum = TChar and TChar:FindFirstChildOfClass("Humanoid")
		local TRoot = THum and THum.RootPart
		if not (TChar and THum and TRoot and TRoot.Parent) then return end
		if THum.Health <= 0 then return end
		if THum.Sit then KF.notify("Busy", TargetPlayer.Name .. " is sitting", 2) return end
		pcall(function()
			if Root.AssemblyLinearVelocity.Magnitude < 50 then KF.oldPos = Root.CFrame end
		end)
		flinging = true
		local myGen = (WGT.flingGen or 0)
		local ff = Instance.new("ForceField")
		ff.Visible = false
		ff.Parent = Char
		pcall(function() workspace.FallenPartsDestroyHeight = -1000000 end)
		pcall(function() Hum:SetStateEnabled(Enum.HumanoidStateType.Seated, false) end)
		pcall(function() Root.CanCollide = true end)
		local t0 = os.clock()
		local timeout = 2.2
		local spin, tick = 0, 0
		local peakT = 0
		while KF.active and WGT.isAlive() do
			if KF.abort or (WGT.flingGen or 0) ~= myGen then break end
			if not (Hum and Hum.Parent and Hum.Health > 0) then break end
			if not (Root and Root.Parent) then break end
			TChar = TargetPlayer.Character
			THum = TChar and TChar:FindFirstChildOfClass("Humanoid")
			TRoot = THum and THum.RootPart
			if not (TChar and THum and TRoot and TRoot.Parent) then break end
			if THum.Health <= 0 then break end
			if os.clock() - t0 > timeout then break end
			local tv = 0
			pcall(function() tv = TRoot.AssemblyLinearVelocity.Magnitude end)
			if tv > peakT then peakT = tv end
			if tv > 120 then task.wait(0.15) break end
			spin += 110
			tick += 1
			WGT.flingGrace = os.clock() + 0.15
			pcall(function()
				local ang = CFrame.Angles(math.rad(spin), 0, 0)
				if tick % 2 == 0 then
					Root.CFrame = TRoot.CFrame * CFrame.new(0, 1.6, 0) * ang
				else
					Root.CFrame = TRoot.CFrame * CFrame.new(0, -1.6, 0) * ang
				end
				Root.AssemblyLinearVelocity = Vector3.new(9e4, 9e4, 9e4)
				Root.AssemblyAngularVelocity = Vector3.new(9e4, 9e4, 9e4)
			end)
			task.wait()
		end
		pcall(function()
			if Root and Root.Parent then
				Root.AssemblyLinearVelocity = Vector3.zero
				Root.AssemblyAngularVelocity = Vector3.zero
			end
		end)
		pcall(function()
			if Root and Root.Parent then
				Root.Velocity = Vector3.zero
				Root.RotVelocity = Vector3.zero
			end
		end)
		pcall(function() if ff and ff.Parent then ff:Destroy() end end)
		pcall(function() Hum:SetStateEnabled(Enum.HumanoidStateType.Seated, true) end)
		pcall(function() workspace.FallenPartsDestroyHeight = KF.fpdh end)
		if KF.oldPos and WGT.isAlive() and not KF.abort and (WGT.flingGen or 0) == myGen then
			pcall(function()
				local h = plr.Character and plr.Character:FindFirstChild("HumanoidRootPart")
				local m = plr.Character and plr.Character:FindFirstChildOfClass("Humanoid")
				if h and h.Parent and m and m.Health > 0 then
					h.Anchored = true
					h.CFrame = KF.oldPos * CFrame.new(0, 0.5, 0)
					h.AssemblyLinearVelocity = Vector3.zero
					h.AssemblyAngularVelocity = Vector3.zero
				end
			end)
			task.wait()
			pcall(function()
				local h = plr.Character and plr.Character:FindFirstChild("HumanoidRootPart")
				if h and h.Parent then
					if KF.oldPos then h.CFrame = KF.oldPos * CFrame.new(0, 0.5, 0) end
					h.AssemblyLinearVelocity = Vector3.zero
					h.AssemblyAngularVelocity = Vector3.zero
					h.Anchored = false
				end
			end)
		end
		WGT.flingGrace = 0
		flinging = false
		log(string.format("fling %s: %.1fs peak=%.0f", TargetPlayer.Name, os.clock() - t0, peakT))
	end

	KF.start = function()
		if KF.active then return end
		if KF.touch then log("stop touch fling first") return false end
		if KF.count() == 0 then
			if KF.lbl then KF.lbl.Text = "⚠️ НЕТ ЦЕЛЕЙ!" end
			WGT.delay(1, KF.status)
			return
		end
		KF.active = true
		KF.abort = false
		KF.status()
		KF.notify("Запущен", "Флинг " .. KF.count() .. " целей", 2)
		log("fling on: " .. KF.count())
		WGT.spawn(function()
			while KF.active and WGT.isAlive() do
				local valid = {}
				for name, p in pairs(KF.sel) do
					if p and p.Parent and p.Character then valid[name] = p
					else
						KF.sel[name] = nil
						local m = KF.boxes[name]
						if m then m.Visible = false end
					end
				end
				for _, p in pairs(valid) do
					if KF.active and WGT.isAlive() then pcall(KF.fling, p) task.wait(0.1) else break end
				end
				KF.status()
				task.wait(0.5)
			end
			flinging = false
		end)
	end

