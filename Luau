					end
				end
			end
		end)
		pcall(function()
			if not found then
				for _, v in pairs(game:GetService("ReplicatedStorage"):GetDescendants()) do
					if not found and v:IsA("RemoteEvent") then
						local n = string.lower(v.Name)
						if string.find(n, "gunshoot", 1, true) or string.find(n, "shootgun", 1, true) or string.find(n, "firegun", 1, true) then
							found = v
						end
					end
				end
			end
		end)
		return found
	end
	-- выстрел ВСЕМИ путями сразу: ган может слушать клик (Button1Down),
	-- а не Activate. Кулдаун гана съедает дубли, зато хоть один путь сработает.
	local function fireGun(tool, pos)
		local how = "none"
		if typeof(mouse1click) == "function" then
			if pcall(mouse1click) then how = "click" end
		elseif typeof(mouse1press) == "function" then
			pcall(function()
				mouse1press()
				task.wait(0.05)
				if typeof(mouse1release) == "function" then mouse1release() end
			end)
			how = "press"
		else
			pcall(function()
				local vim = game:GetService("VirtualInputManager")
				if vim then
					local mp = UIS:GetMouseLocation()
					vim:SendMouseButtonEvent(mp.X, mp.Y, 0, true, game, 1)
					task.wait(0.05)
					vim:SendMouseButtonEvent(mp.X, mp.Y, 0, false, game, 1)
					how = "vim"
				end
			end)
		end
		if typeof(firesignal) == "function" then pcall(function() firesignal(tool.Activated) end) end
		pcall(function() tool:Activate() end)
		if how == "none" then how = "activate" end
		if not shootRemote then shootRemote = findShootRemote(tool) end
		if shootRemote then
			if not shootLogged then shootLogged = true log("shoot remote: " .. shootRemote:GetFullName()) end
			pcall(function() shootRemote:FireServer(pos) end)
			how = how .. "+remote"
		end
		return how
	end
	local killed = false
	local lastShot = 0
	local t0 = os.clock()
	while os.clock() - t0 < 4 do
		if not manual and not WGT.sheriffHunt then break end
		if flinging then break end
		if m.Character ~= tc0 then break end -- цель сменилась/респавн — стоп
		ch = plr.Character
		hum = ch and ch:FindFirstChildOfClass("Humanoid")
		hrp = ch and ch:FindFirstChild("HumanoidRootPart")
		local tc = m.Character
		local hd = tc and tc:FindFirstChild("Head")
		local th = tc and tc:FindFirstChildOfClass("Humanoid")
		local tr = tc and tc:FindFirstChild("HumanoidRootPart")
		if not (hum and hrp and hum.Health > 0) then break end
		if not (th and hd and tr and th.Health > 0) then killed = true break end
		-- ЛИПНЕМ над головой: бегать бесполезно, резануть вверх сложно
		pcall(function()
			hrp.CFrame = tr.CFrame * CFrame.new(0, 2.8, 0)
			hrp.AssemblyLinearVelocity = Vector3.zero
			hrp.AssemblyAngularVelocity = Vector3.zero
		end)
		WGT.flingGrace = os.clock() + 0.15
		local aimP = hd.Position
		pcall(function()
			local hv = hd.AssemblyLinearVelocity
			if hv then
				local lead = hv * 0.15
				if lead.Magnitude > 6 then lead = lead.Unit * 6 end
				aimP = aimP + lead
			end
		end)
		-- ПРИЦЕЛ ТОЛЬКО МЫШЬЮ: в FirstPerson камера сама идёт за курсором.
		-- Прямые записи cam.CFrame камерный модуль затирает каждый кадр —
		-- поэтому раньше смотрела прямо. Без mousemoverel — fallback на камеру.
		lastAim = aimP
		if hasMMR and cam then
			pcall(function()
				local sp, vis = cam:WorldToViewportPoint(aimP)
				if vis then
					local inset = game:GetService("GuiService"):GetGuiInset()
					local mp = UIS:GetMouseLocation() - inset
					local dx, dy = sp.X - mp.X, sp.Y - mp.Y
					if dx == dx and dy == dy and math.abs(dx) + math.abs(dy) > 2 then
						dx = math.clamp(dx, -500, 500)
						dy = math.clamp(dy, -500, 500)
						mousemoverel(dx, dy)
						movedX += dx
						movedY += dy
					end
				end
			end)
		elseif cam then
			pcall(function() cam.CFrame = CFrame.lookAt(cam.CFrame.Position, aimP) end)
		end
		RS.Heartbeat:Wait()
		if os.clock() - lastShot >= 0.6 then
			lastShot = os.clock()
			local chNow = plr.Character
			if gun.Parent ~= chNow then
				local humNow = chNow and chNow:FindFirstChildOfClass("Humanoid")
				if humNow then pcall(function() humNow:EquipTool(gun) end) end
			elseif lastAim then
				-- ФИНАЛЬНАЯ ДОВОДКА: камера уже подошла за мышью — пересчитываем
				-- проекцию и дотягиваем остаток мелкими шагами, только потом спуск
				if hasMMR and cam then
					pcall(function()
						for k = 1, 2 do
							local tcF = m.Character
							local hdF = tcF and tcF:FindFirstChild("Head")
							if not hdF then break end
							local sp2, vis2 = cam:WorldToViewportPoint(hdF.Position)
							if vis2 then
								local inset2 = game:GetService("GuiService"):GetGuiInset()
								local mp2 = UIS:GetMouseLocation() - inset2
								local dx2, dy2 = sp2.X - mp2.X, sp2.Y - mp2.Y
								if dx2 == dx2 and dy2 == dy2 and math.abs(dx2) + math.abs(dy2) > 2 then
									local cx = math.clamp(dx2, -60, 60)
									local cy = math.clamp(dy2, -60, 60)
									mousemoverel(cx, cy)
									movedX += cx
									movedY += cy
								end
							end
							RS.Heartbeat:Wait()
						end
					end)
				end
				local how = fireGun(gun, lastAim)
				if not methodLogged then methodLogged = true log("fire via " .. how) end
			end
		end
	end
	local thF = (m.Character == tc0) and m.Character:FindFirstChildOfClass("Humanoid") or nil
	if not thF or thF.Health <= 0 then killed = true end
	if hasMMR and (movedX ~= 0 or movedY ~= 0) then
		pcall(function() mousemoverel(-movedX, -movedY) end)
	end
	WGT.flingGrace = 0
	pcall(function()
		local c = plr.Character
		local h = c and c:FindFirstChild("HumanoidRootPart")
		local mh = c and c:FindFirstChildOfClass("Humanoid")
		if h and h.Parent and mh and mh.Health > 0 then
			h.AssemblyLinearVelocity = Vector3.zero
			h.AssemblyAngularVelocity = Vector3.zero
			h.CFrame = startCF
		end
	end)
	task.wait(0.05)
	pcall(function()
		local c = plr.Character
		local h = c and c:FindFirstChild("HumanoidRootPart")
		local mh = c and c:FindFirstChildOfClass("Humanoid")
		if h and h.Parent and mh and mh.Health > 0 then
			h.CFrame = startCF
			h.AssemblyLinearVelocity = Vector3.zero
			h.AssemblyAngularVelocity = Vector3.zero
			h.Anchored = false
		end
	end)
	pcall(function()
		local mh = plr.Character and plr.Character:FindFirstChildOfClass("Humanoid")
		if mh and workspace.CurrentCamera then workspace.CurrentCamera.CameraSubject = mh end
		plr.CameraMode = Enum.CameraMode.Classic
	end)
	log(killed and ("KILLED " .. m.Name) or ("missed " .. m.Name .. " (жив)"))
end
