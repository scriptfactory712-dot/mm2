		if specTarget then
			local tHum = specTarget.Character and specTarget.Character:FindFirstChildOfClass("Humanoid")
			if specTarget.Parent and tHum and tHum.Health > 0 then
				pcall(function() workspace.CurrentCamera.CameraSubject = tHum end)
			else
				setSpec(nil)
			end
		else
			local mh = plr.Character and plr.Character:FindFirstChildOfClass("Humanoid")
