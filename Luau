local WGT = {
	tgGet = {}, tgSet = {}, slGet = {}, slSet = {}, clGet = {}, clSet = {}, ddGet = {}, ddSet = {},
	conns = {}, tasks = {}, cleanups = {}, originals = {}, remembered = {}, unloaded = false,
}
local log = function(text) warn("[LuaHubV1] " .. tostring(text)) end
local function keep(c)
	if WGT.unloaded then
		pcall(function() c:Disconnect() end)
	else
		table.insert(WGT.conns, c)
	end
	return c
end
local function safe(fn, ...)
	if type(fn) ~= "function" then
		log("callback is not a function: " .. type(fn))
		return false
	end
	local ok, res = xpcall(fn, function(e) return debug.traceback(tostring(e), 2) end, ...)
	if not ok then
		pcall(log, "error: " .. tostring(res))
		warn("[LuaHubV1] " .. tostring(res))
	end
	return ok, res
end
WGT.isAlive = function() local window = WGT.window return not WGT.unloaded and gui.Parent ~= nil and window ~= nil and not window.Destroyed end
WGT.onUnload = function(fn)
	if WGT.unloaded then pcall(fn) else table.insert(WGT.cleanups, fn) end
end
WGT.spawn = function(fn, ...)
	if not WGT.isAlive() then return nil end
	local args = table.pack(...)
	local thread = task.defer(function()
		if WGT.isAlive() then safe(fn, table.unpack(args, 1, args.n)) end
		WGT.tasks[coroutine.running()] = nil
	end)
	WGT.tasks[thread] = true
	return thread
end
WGT.delay = function(seconds, fn, ...)
	if not WGT.isAlive() then return nil end
	local args = table.pack(...)
	local thread = task.delay(seconds, function()
		if WGT.isAlive() then safe(fn, table.unpack(args, 1, args.n)) end
		WGT.tasks[coroutine.running()] = nil
	end)
	WGT.tasks[thread] = true
	return thread
end
WGT.remember = function(object, property)
	if not object then return end
	local saved = WGT.remembered[object]
	if not saved then saved = {} WGT.remembered[object] = saved end
	if saved[property] then return end
	local ok, value = pcall(function() return object[property] end)
	if ok then
		saved[property] = true
		table.insert(WGT.originals, {object = object, property = property, value = value})
	end
end
WGT.shutdown = function(destroyGui)
	if WGT.unloaded then return end
	WGT.unloaded = true
	for _, c in ipairs(WGT.conns) do pcall(function() c:Disconnect() end) end
	table.clear(WGT.conns)
	local running = coroutine.running()
	for thread in pairs(WGT.tasks) do
		if thread ~= running then pcall(task.cancel, thread) end
	end
	table.clear(WGT.tasks)
	for i = #WGT.cleanups, 1, -1 do
		local ok, err = pcall(WGT.cleanups[i])
		if not ok then warn("[LuaHubV1] cleanup: " .. tostring(err)) end
	end
	table.clear(WGT.cleanups)
	for i = #WGT.originals, 1, -1 do
		local saved = WGT.originals[i]
		pcall(function()
			-- CameraSubject запоминали на момент инжекта. После респаунов
			-- это мертвый гуманоид: его откат затирал живой Subject
			-- (который уже выставил onUnload-фикс) и камера висела.
			if saved.property == "CameraSubject" then
				local v = saved.value
				local alive = v ~= nil and v.Parent ~= nil
				if alive and v:IsA("Humanoid") and v.Health <= 0 then alive = false end
				if not alive then return end
			end
			saved.object[saved.property] = saved.value
		end)
	end
	table.clear(WGT.originals)
	table.clear(WGT.remembered)
	-- Финальный откат камеры ПОСЛЕ всех cleanups/originals: раньше фикс
	-- в onUnload затирался поздними чистками (freecam) и мертвым Subject.
	-- Сюда уже ничего не пишет - камера остается на живом персе.
	pcall(function()
		local cam = workspace.CurrentCamera
		local ch = plr.Character
		local hum = ch and ch:FindFirstChildOfClass("Humanoid")
		if cam and hum and hum.Health > 0 then
			cam.CameraSubject = hum
		end
		plr.CameraMode = Enum.CameraMode.Classic
		if hum then hum.CameraOffset = Vector3.zero end
		local fp = workspace:FindFirstChild("_freecam")
		if fp then fp:Destroy() end
	end)
	if destroyGui ~= false then pcall(function() gui:Destroy() end) end
end
keep(gui.Destroying:Connect(function() WGT.shutdown(false) end))
do
	for _, property in ipairs({"Gravity", "FallenPartsDestroyHeight"}) do WGT.remember(workspace, property) end
	for _, property in ipairs({"Brightness", "ClockTime", "FogStart", "FogEnd", "GlobalShadows", "Ambient", "OutdoorAmbient", "ColorShift_Top", "ColorShift_Bottom"}) do WGT.remember(Lighting, property) end
	for _, property in ipairs({"CameraMode", "CameraMinZoomDistance", "CameraMaxZoomDistance"}) do WGT.remember(plr, property) end
	WGT.remember(UIS, "MouseIconEnabled")
	local function rememberCamera()
		WGT.remember(workspace.CurrentCamera, "FieldOfView")
		WGT.remember(workspace.CurrentCamera, "CameraSubject")
	end
	rememberCamera()
	keep(workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(rememberCamera))
	local states = {}
	local function rememberCharacter(ch)
		local hum = ch:FindFirstChildOfClass("Humanoid") or ch:WaitForChild("Humanoid", 5)
		if not hum or WGT.unloaded then return end
		for _, property in ipairs({"WalkSpeed", "JumpPower", "UseJumpPower", "PlatformStand", "CameraOffset", "NameDisplayDistance"}) do WGT.remember(hum, property) end
		for _, state in ipairs({Enum.HumanoidStateType.Jumping, Enum.HumanoidStateType.FallingDown, Enum.HumanoidStateType.Seated, Enum.HumanoidStateType.Swimming}) do
			table.insert(states, {hum = hum, state = state, enabled = hum:GetStateEnabled(state)})
		end
	end
	if plr.Character then rememberCharacter(plr.Character) end
	keep(plr.CharacterAdded:Connect(rememberCharacter))
	WGT.onUnload(function()
		for _, entry in ipairs(states) do pcall(function() entry.hum:SetStateEnabled(entry.state, entry.enabled) end) end
	end)
end

-- One asynchronous role cache is shared by all MM2 features.
WGT.mm2 = {roles = {}, lastRequest = -math.huge, fetching = false, generation = 0}
WGT.mm2.update = function(data)
	if not WGT.isAlive() or type(data) ~= "table" then return end
	local roles = {}
	for name, entry in pairs(data) do
		if type(name) == "string" and type(entry) == "table" then roles[name] = entry end
	end
	WGT.mm2.roles = roles
end
WGT.mm2.refresh = function()
	local state = WGT.mm2
	local now = os.clock()
	if not WGT.isAlive() or state.fetching or now - state.lastRequest < 1 then return end
	state.lastRequest = now
	local storage = game:GetService("ReplicatedStorage")
	local changed = storage:FindFirstChild("PlayerDataChanged", true)
	if changed and changed:IsA("RemoteEvent") and changed ~= state.changed then
		if state.changedConn then state.changedConn:Disconnect() end
		state.changed = changed
		state.changedConn = keep(changed.OnClientEvent:Connect(WGT.mm2.update))
	end
	local remote = storage:FindFirstChild("GetPlayerData", true)
	if not remote or not remote:IsA("RemoteFunction") then return end
	state.fetching = true
	state.generation += 1
	local generation = state.generation
	local thread = WGT.spawn(function()
		local ok, data = pcall(function() return remote:InvokeServer() end)
		if state.generation ~= generation then return end
		state.fetching = false
		if ok then WGT.mm2.update(data) end
	end)
	WGT.delay(5, function()
		if state.fetching and state.generation == generation then
			state.generation += 1
			state.fetching = false
			pcall(task.cancel, thread)
			WGT.tasks[thread] = nil
		end
	end)
end
WGT.getPlayerRole = function()
	WGT.mm2.refresh()
	local entry = WGT.mm2.roles[plr.Name]
	return entry and entry.Role or nil
end
