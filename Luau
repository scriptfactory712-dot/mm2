-- MM2 роли (общие: Visual ESP + MM2 таб)
-- hasTool инлайнен в getRole (был отдельной функцией, -1 регистр)
-- БЫЛО: getRole на каждый вызов создавал до 6 замыканий (has/check), а его
-- зовут для каждого игрока в RenderStepped аимбота и каждый тик фарма ->
-- тысячи аллокаций в секунду -> просадки кадров через GC. Теперь ноль замыканий.
local function hasToolIn(container, w1, w2, w3)
	if not container then return false end
	for _, v in pairs(container:GetChildren()) do
		if v:IsA("Tool") then
			local n = string.lower(v.Name)
			if string.find(n, w1, 1, true) then return true end
			if w2 and string.find(n, w2, 1, true) then return true end
			if w3 and string.find(n, w3, 1, true) then return true end
		end
	end
	return false
end
local function getRole(p)
	local bp = p:FindFirstChild("Backpack")
	local ch = p.Character
	if hasToolIn(bp, "knife") or hasToolIn(ch, "knife") then return "murder" end
	if hasToolIn(bp, "gun", "revolver") or hasToolIn(ch, "gun", "revolver") then return "sheriff" end
	return "innocent"
end

local function findMurderSheriff()
	local m, s = nil, nil
	for _, p in pairs(Players:GetPlayers()) do
		local r = getRole(p)
		if r == "murder" and not m then m = p end
		if r == "sheriff" and not s then s = p end
	end
	return m, s
end

-- Поиск гана/монет (общие: Visual + MM2 + farm).
-- БЫЛО: findGunDrop() дважды проходил workspace:GetDescendants() (это десятки
-- тысяч инстансов) и звался из циклов каждые 0.5-3 с -> постоянные фризы.
-- Теперь один проход + кэш (refreshCoin/gun/... общий, раз в ~1.2 с).
local scanCache = {}
local function findGunDrop()
	if (os.clock() - (scanCache.gun or -99)) <= 1.2 then return scanCache.gunVal end
	local hit = nil
	-- один проход сразу по обоим критериям
	for _, v in pairs(workspace:GetDescendants()) do
		if not hit then
			if v:IsA("BasePart") then
				if v.Name == "GunDrop" or v.Name == "Gun" then
					hit = v
				end
			elseif v:IsA("Tool") and string.find(string.lower(v.Name), "gun", 1, true) then
				local par = v.Parent
				local isPlayerItem = false
				if par and Players:GetPlayerFromCharacter(par) then isPlayerItem = true end
				if par and par:IsA("Backpack") then isPlayerItem = true end
				if not isPlayerItem then
					local h = v:FindFirstChild("Handle")
					if h and h:IsA("BasePart") then hit = h else hit = v end
				end
			end
		end
	end
	scanCache.gun = os.clock()
	scanCache.gunVal = hit
	return hit
end

-- полный список "coin"-объектов + отдельно Coin_Server для фарма (один проход)
local function scanPickups()
	if (os.clock() - (scanCache.coins or -99)) <= 1.2 then
		return scanCache.coinList or {}, scanCache.serverCoins or {}
	end
	local out, srv = {}, {}
	local all = workspace:GetDescendants()
	for _, v in pairs(all) do
		local ln = string.lower(v.Name)
		if string.find(ln, "coin", 1, true) then
			if v:IsA("BasePart") then
				if #out < 80 then table.insert(out, v) end
			elseif v:IsA("Model") then
				if #out < 80 then table.insert(out, v) end
			end
			if v.Name == "Coin_Server" and v:IsA("BasePart") then table.insert(srv, v) end
		end
	end
	scanCache.coins = os.clock()
	scanCache.coinList = out
	scanCache.serverCoins = srv
	return out, srv
end

