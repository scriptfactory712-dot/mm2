					local alive = specTarget.Parent
						and specTarget.Character
						and specTarget.Character:FindFirstChildOfClass("Humanoid")
						and specTarget.Character:FindFirstChildOfClass("Humanoid").Health > 0
					if not alive then setSpec(nil) end
				end)
			end
			task.wait(1)
		end
	end)
	toggle(PG.player, "follow spectate target", false, function(s)
