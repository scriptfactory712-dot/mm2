WGT.CFG_KEY = "LuaHubV1_Config"
WGT.cfgFile = function()
	return WGT.CFG_KEY .. "_s" .. tostring(WGT.cfgSlot or 1) .. ".json"
end
WGT.cfgSave = function()
	local d, n = {}, 0
	for prefix, getters in pairs({T_ = WGT.tgGet, S_ = WGT.slGet, C_ = WGT.clGet, D_ = WGT.ddGet}) do
		for key, get in pairs(getters) do
			local ok, value = safe(get)
			if ok then
				if typeof(value) == "Color3" then value = {value.R * 255, value.G * 255, value.B * 255} end
				d[prefix .. key] = value
				n += 1
			end
		end
	end
	-- точки телепорта едут в конфиг (12 компонентов CFrame каждая),
	-- иначе save spot слетает при каждом перезапуске скрипта
	for slot, cf in pairs(WGT.tpSpots or {}) do
		if typeof(cf) == "CFrame" then
			local okCf, c12 = pcall(function() return table.pack(cf:GetComponents()) end)
			if okCf and c12 and type(c12[1]) == "number" then
				local arr = {}
				for i = 1, 12 do arr[i] = c12[i] end
				d["tpSpots"] = d["tpSpots"] or {}
				d["tpSpots"][tostring(slot)] = arr
				n += 1
			end
		end
	end
	local encoded, s = pcall(function() return game:GetService("HttpService"):JSONEncode(d) end)
	if not encoded then log("config encode failed: " .. tostring(s)) return false end
	local saved = false
	if typeof(writefile) == "function" then saved = pcall(writefile, WGT.cfgFile(), s) end
	if not saved and typeof(SaveJSON) == "function" then saved = pcall(SaveJSON, WGT.cfgFile(), d) end
	if saved then log("config saved (" .. n .. " settings)") return true end
	local copied = false
	for _, copy in pairs({setclipboard, toclipboard, set_clipboard}) do
		if typeof(copy) == "function" and pcall(copy, s) then copied = true break end
	end
	log(copied and ("config copied to clipboard (" .. n .. " settings)") or "save failed: no working file or clipboard API")
	return copied
end
WGT.cfgLoad = function()
	if not WGT.isAlive() then return false end
	local raw
	if typeof(readfile) == "function" then
		local ok, value = pcall(readfile, WGT.cfgFile())
		if ok then raw = value end
	end
	if raw == nil and typeof(LoadJSON) == "function" then
		local ok, value = pcall(LoadJSON, WGT.cfgFile())
		if ok then raw = value end
	end
	if raw == nil then log("no config found") return false end
	if type(raw) == "string" then
		local ok, value = pcall(function() return game:GetService("HttpService"):JSONDecode(raw) end)
		if not ok then log("config broken: " .. tostring(value)) return false end
		raw = value
	end
	if type(raw) ~= "table" then log("config broken: expected an object") return false end
	local keys = {}
	for key in pairs(raw) do if type(key) == "string" then table.insert(keys, key) end end
	table.sort(keys)
	local loaded, skipped = 0, 0
	-- Values are restored before switches can start background work.
	for _, prefix in ipairs({"S_", "C_", "D_", "T_"}) do
		local setters = ({S_ = WGT.slSet, C_ = WGT.clSet, D_ = WGT.ddSet, T_ = WGT.tgSet})[prefix]
		for _, key in ipairs(keys) do
			if string.sub(key, 1, 2) ~= prefix then continue end
			local value = raw[key]
			if prefix == "C_" and type(value) == "table" then
				local valid = true
				for i = 1, 3 do
					local component = value[i]
					if type(component) ~= "number" or component ~= component or math.abs(component) == math.huge then valid = false break end
				end
				if valid then value = Color3.fromRGB(math.clamp(value[1], 0, 255), math.clamp(value[2], 0, 255), math.clamp(value[3], 0, 255)) else skipped += 1 continue end
			end
			local setter = setters[string.sub(key, 3)]
			if setter then
				local ok, accepted = safe(setter, value)
				if ok and accepted ~= false then loaded += 1 else skipped += 1 end
			end
		end
	end
	local function loadSpot(arr)
		if type(arr) ~= "table" then return nil end
		for i = 1, 12 do
			local c = arr[i]
			if type(c) ~= "number" or c ~= c or math.abs(c) == math.huge then return nil end
		end
		local cf = nil
		pcall(function() cf = CFrame.new(table.unpack(arr, 1, 12)) end)
		return cf
	end
	WGT.tpSpots = WGT.tpSpots or {}
	local spots = raw["tpSpots"]
	if type(spots) == "table" then
		for slot, arr in pairs(spots) do
			local cf = loadSpot(arr)
			if cf then WGT.tpSpots[tostring(slot)] = cf loaded += 1 else skipped += 1 end
		end
	end
	-- legacy: старый одиночный tpSpot едет в слот 1
	if raw["tpSpot"] ~= nil and WGT.tpSpots["1"] == nil then
		local cf = loadSpot(raw["tpSpot"])
		if cf then WGT.tpSpots["1"] = cf loaded += 1 else skipped += 1 end
	end
	log("config loaded (" .. loaded .. " settings, " .. skipped .. " skipped)")
	return true
end

