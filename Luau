keep(RS.RenderStepped:Connect(function()
	if (not boxOn and not dotOn and not arrowOn) or not WGT.isAlive() then return end
	local cam = workspace.CurrentCamera
	if not cam then return end
	local sx, sy = cam.ViewportSize.X, cam.ViewportSize.Y
	for _, p in pairs(Players:GetPlayers()) do
		if p ~= plr and p.Character then
			local hrp = p.Character:FindFirstChild("HumanoidRootPart")
			local hum = p.Character:FindFirstChildOfClass("Humanoid")
			local head = p.Character:FindFirstChild("Head")
			local alive = hrp and hum and hum.Health > 0
			if boxOn and alive and head then
				local arr = boxObjs[p]
				if not arr then
					arr = {}
					for i = 1, 4 do
						local ok, ln = pcall(function() return Drawing.new("Line") end)
						if not ok or not ln then arr = nil break end
						ln.Visible = false
						ln.Thickness = 1.5
						arr[i] = ln
					end
					if arr then boxObjs[p] = arr end
				end
				if arr then
					local t2d, tVis = cam:WorldToViewportPoint(head.Position + Vector3.new(0, 0.8, 0))
					local b2d, bVis = cam:WorldToViewportPoint(hrp.Position - Vector3.new(0, 3, 0))
					if tVis and bVis then
						local h = math.abs(b2d.Y - t2d.Y)
						local w = h / 2
						local cx = (t2d.X + b2d.X) / 2
						local y1 = math.min(t2d.Y, b2d.Y)
						local y2 = math.max(t2d.Y, b2d.Y)
						local col = roleColor(p)
						local x1 = cx - w / 2
						local x2 = cx + w / 2
						local fr = {Vector2.new(x1, y1), Vector2.new(x2, y1)}
						local to = {Vector2.new(x2, y1), Vector2.new(x2, y2)}
						local bk = {Vector2.new(x2, y2), Vector2.new(x1, y2)}
						local lf = {Vector2.new(x1, y2), Vector2.new(x1, y1)}
						local sides = {fr, to, bk, lf}
						for i = 1, 4 do
							arr[i].Visible = true
							arr[i].From = sides[i][1]
							arr[i].To = sides[i][2]
							arr[i].Color = col
						end
					else
						for i = 1, 4 do arr[i].Visible = false end
					end
				end
			elseif boxObjs[p] then
				for _, ln in ipairs(boxObjs[p]) do ln.Visible = false end
			end
			if dotOn and alive and head then
				local c = dotObjs[p]
				if not c then
					local ok, res = pcall(function() return Drawing.new("Circle") end)
					if ok and res then
						res.Radius = 3
						res.Filled = true
						res.Visible = false
						dotObjs[p] = res
						c = res
					end
				end
				if c then
					local hp2d, hVis = cam:WorldToViewportPoint(head.Position)
					if hVis then
						c.Visible = true
						c.Position = Vector2.new(hp2d.X, hp2d.Y)
						c.Color = roleColor(p)
					else
						c.Visible = false
					end
				end
			elseif dotObjs[p] then
				dotObjs[p].Visible = false
			end
			if arrowOn and alive and hrp then
				local arr = arrowObjs[p]
				if not arr then
					arr = {}
					for i = 1, 2 do
						local ok, ln = pcall(function() return Drawing.new("Line") end)
						if not ok or not ln then arr = nil break end
						ln.Visible = false
						ln.Thickness = 2
						arr[i] = ln
					end
					if arr then arrowObjs[p] = arr end
				end
				local _, vis = cam:WorldToViewportPoint(hrp.Position)
				if arr and not vis then
					local rel = cam.CFrame:PointToObjectSpace(hrp.Position)
					local dx, dy = rel.X, -rel.Y
					if rel.Z > 0 then dx, dy = -dx, -dy end
					local ang = math.atan2(dy, dx)
					local rad = math.min(sx, sy) / 2 - 30
					local ex = sx / 2 + math.cos(ang) * rad
					local ey = sy / 2 + math.sin(ang) * rad
					local bx = ex - math.cos(ang) * 14
					local by = ey - math.sin(ang) * 14
					local px = -math.sin(ang) * 10
					local py = math.cos(ang) * 10
					local col = roleColor(p)
					arr[1].Visible = true
					arr[1].From = Vector2.new(ex, ey)
					arr[1].To = Vector2.new(bx + px, by + py)
					arr[1].Color = col
					arr[2].Visible = true
					arr[2].From = Vector2.new(ex, ey)
					arr[2].To = Vector2.new(bx - px, by - py)
					arr[2].Color = col
				elseif arr then
					arr[1].Visible = false
					arr[2].Visible = false
				end
			elseif arrowObjs[p] then
				arrowObjs[p][1].Visible = false
				arrowObjs[p][2].Visible = false
			end
		end
	end
	for p, arr in pairs(boxObjs) do
		if p.Parent ~= Players then
			for _, ln in ipairs(arr) do pcall(function() ln:Remove() end) end
			boxObjs[p] = nil
		end
	end
	for p, c in pairs(dotObjs) do
		if p.Parent ~= Players then
			pcall(function() c:Remove() end)
			dotObjs[p] = nil
		end
	end
	for p, arr in pairs(arrowObjs) do
		if p.Parent ~= Players then
			for _, ln in ipairs(arr) do pcall(function() ln:Remove() end) end
			arrowObjs[p] = nil
		end
	end
end))

local xraySaved = {}
local xrayVal = -1
local xrayGen = 0
local function setXray(v)
	-- БЫЛО: полный обход workspace:GetDescendants() на КАЖДОЕ движение слайдера
	-- (т.е. десятки раз в секунду) -> жёсткие фризы. Теперь троттлинг 0.3 с,
	-- и новый проход глушит предыдущий (иначе петли копились бы).
	v = math.clamp(v, 0, 100)
	if v == xrayVal then return end
	xrayVal = v
	xrayGen += 1
	local myGen = xrayGen
	if v <= 0 then
		pcall(function()
			for d, was in pairs(xraySaved) do
				if d and d.Parent then d.Transparency = was end
			end
		end)
		table.clear(xraySaved)
		return
	end
	WGT.spawn(function()
		while WGT.isAlive() and myGen == xrayGen do
			pcall(function()
				for _, d in pairs(workspace:GetDescendants()) do
					if d:IsA("BasePart") and d.Name ~= "_freecam" then
						local m = d:FindFirstAncestorOfClass("Model")
						if not (m and Players:GetPlayerFromCharacter(m)) then
							if xraySaved[d] == nil then xraySaved[d] = d.Transparency end
							local t = xrayVal / 100
							if t > xraySaved[d] then d.Transparency = t end
						end
					end
				end
			end)
			task.wait(0.3)
		end
	end)
end
