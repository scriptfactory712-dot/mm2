-- ESP/отрисовка (ESP System, tracers, box/dot/arrow, items, freecam, x-ray,
-- saturation): обёрнуто в функцию ради лимита 200 регистров чанка.
-- Наружу торчат только WGT.* в конце; всё остальное живёт во фрейме.
local function initVisualSys()

-- ESP System (user version, GetPlayerData roles)
-- Murder red, Sheriff blue, Hero yellow, else green. 1 тумблер ESP System.
-- В функции: экономия регистров чанка (лимит 200)
local function initESP()
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local espSystemOn = false
local espPlayer, espMurder, espSheriff = false, false, false
local ESPHighlights = {}
local ESP_Roles = {}
local ESP_MurderName, ESP_SheriffName, ESP_HeroName = nil, nil, nil
local characterConnections = {}

local function ESP_IsAlive(player)
	for name, data in pairs(ESP_Roles) do
		if player.Name == name then
			return not data.Killed and not data.Dead
		end
	end
	return false
end

local function ESP_UpdateHighlights()
	for _, player in ipairs(Players:GetPlayers()) do
		if player ~= plr and player.Character and player.Character:FindFirstChild("Humanoid") and player.Character:FindFirstChild("Highlight") then
			local hl = player.Character:FindFirstChild("Highlight")
			pcall(function()
				if player.Name == ESP_SheriffName and ESP_IsAlive(player) then
					hl.FillColor = Color3.fromRGB(0, 0, 255)
				elseif player.Name == ESP_MurderName and ESP_IsAlive(player) then
					hl.FillColor = Color3.fromRGB(255, 0, 0)
				elseif player.Name == ESP_HeroName and ESP_IsAlive(player) then
					local sh = ESP_SheriffName and Players:FindFirstChild(ESP_SheriffName) or nil
					local shAlive = sh and ESP_IsAlive(sh) or false
					if not shAlive then
						hl.FillColor = Color3.fromRGB(255, 250, 0)
					else
						hl.FillColor = Color3.fromRGB(0, 255, 0)
					end
				else
					hl.FillColor = Color3.fromRGB(0, 255, 0)
				end
			end)
		end
	end
end
local UpdateHighlights = ESP_UpdateHighlights

local function ESP_SetupCharacterListeners(player)
	if characterConnections[player] then
		pcall(function() characterConnections[player]:Disconnect() end)
		characterConnections[player] = nil
	end
	characterConnections[player] = keep(player.CharacterAdded:Connect(function(character)
		if espSystemOn then
			pcall(function()
				character:WaitForChild("Humanoid", 5)
				if not WGT.isAlive() or not espSystemOn then return end
				if not character:FindFirstChild("Highlight") then
					Instance.new("Highlight", character)
				end
			end)
			pcall(ESP_UpdateHighlights)
		end
	end))
end
local function setupCharacterListeners(player)
	return ESP_SetupCharacterListeners(player)
end

local function CreateHighlight()
	for _, player in ipairs(Players:GetPlayers()) do
		if player ~= plr then
			if player.Character then
				pcall(function()
					player.Character:WaitForChild("Humanoid", 5)
					if not player.Character:FindFirstChild("Highlight") then
						Instance.new("Highlight", player.Character)
					end
				end)
			end
			ESP_SetupCharacterListeners(player)
		end
	end
end

local function DeleteHighlight()
	for _, player in ipairs(Players:GetPlayers()) do
		if player.Character then
			local highlight = player.Character:FindFirstChild("Highlight")
			if highlight then
				pcall(function() highlight:Destroy() end)
			end
		end
		if characterConnections[player] then
			pcall(function() characterConnections[player]:Disconnect() end)
			characterConnections[player] = nil
		end
	end
end
local function IsAlive(player)
	return ESP_IsAlive(player)
end

local function sysClearESP()
	pcall(DeleteHighlight)
	for p, hl in pairs(ESPHighlights) do
		pcall(function() if hl and hl.Parent then hl:Destroy() end end)
	end
	table.clear(ESPHighlights)
	for _, p in pairs(Players:GetPlayers()) do
		if p.Character then
			for _, v in pairs(p.Character:GetDescendants()) do
				if v.Name == "UguzHub_ESP" or v.Name == "_ve" or v.Name == "_vetag" then
					pcall(function() v:Destroy() end)
				end
			end
		end
	end
end
local function espVClear()
	sysClearESP()
end
local function sysApplyESP()
	if not espSystemOn then
		sysClearESP()
		return
	end
	pcall(CreateHighlight)
	pcall(ESP_UpdateHighlights)
end
local function espVAdd(p, tag, frac, role)
	return sysApplyESP()
end
local function espVRefresh()
	pcall(sysApplyESP)
end
local function espVColor(frac, role)
	return Color3.fromRGB(0, 255, 0)
end
WGT.spawn(function()
	-- БЫЛО: InvokeServer() на GetPlayerData раз в секунду ВСЕГДА, даже когда
	-- ESP выключен -> лишний сетевой трафик и риск кика античитом.
	local wasOn, t = false, 0
	while WGT.isAlive() do
		if espSystemOn then
			t += 1
			if not wasOn or t % 5 == 0 then
				pcall(function()
					WGT.mm2.refresh()
					ESP_Roles = WGT.mm2.roles
					if type(ESP_Roles) == "table" then
							ESP_MurderName, ESP_SheriffName, ESP_HeroName = nil, nil, nil
							for name, data in pairs(ESP_Roles) do
								if type(data) == "table" then
									if data.Role == "Murderer" then
										ESP_MurderName = name
									elseif data.Role == "Sheriff" then
										ESP_SheriffName = name
									elseif data.Role == "Hero" then
										ESP_HeroName = name
									end
								end
							end
					end
				end)
			end
		end
		wasOn = espSystemOn
		task.wait(1)
	end
end)
WGT.spawn(function()
	while WGT.isAlive() do
		if espSystemOn then pcall(ESP_UpdateHighlights) end
		task.wait(0.5)
	end
end)
	keep(plr.CharacterAdded:Connect(function(character)
		if espSystemOn then
			pcall(CreateHighlight)
			pcall(ESP_UpdateHighlights)
		end
	end))
	keep(Players.PlayerAdded:Connect(function(player)
		if espSystemOn then
			ESP_SetupCharacterListeners(player)
		end
	end))
	keep(Players.PlayerRemoving:Connect(function(p)
		if characterConnections[p] then
			pcall(function() characterConnections[p]:Disconnect() end)
			characterConnections[p] = nil
		end
		local hl = ESPHighlights[p]
		if hl and hl.Parent then pcall(function() hl:Destroy() end) end
		ESPHighlights[p] = nil
	end))
	return {
		set = function(s)
			espSystemOn = s
			espPlayer, espMurder, espSheriff = s, s, s
			if s then espVRefresh() else espVClear() end
		end,
		clear = function()
			espSystemOn = false
			espPlayer, espMurder, espSheriff = false, false, false
			espVClear()
		end,
