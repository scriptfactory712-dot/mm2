	local function emoStop()
		emoGen += 1
		if currentEmoteTrack then pcall(function() currentEmoteTrack:Stop() end) end
		currentEmoteTrack = nil
	end
	local function emoPlay(id, label)
		lastEmoId, lastEmoLabel = id, label
		emoStop()
		emoGen += 1
		local gen = emoGen
		-- 7yd7 (BangGui_safe): официальный пайплайн в первую очередь —
		-- он дружит с Animate и виден всем. Прямой LoadAnimation — fallback.
		-- Движок/Animate не трогаем: глушим только свой прошлый трек.
		local function startTrack()
			local ch = plr.Character
			local hum = ch and ch:FindFirstChildOfClass("Humanoid")
			if not hum or hum.Health <= 0 then return nil end
			local okOff, offTrack = pcall(function()
				return hum:PlayEmoteAndGetAnimTrackById(id)
			end)
			if okOff and offTrack and typeof(offTrack) == "Instance" and offTrack:IsA("AnimationTrack") then
				pcall(function()
					offTrack.Priority = Enum.AnimationPriority.Action
					offTrack.Looped = true
				end)
				return offTrack
			end
			-- fallback: прямой трек через Animator.
			-- глушим только локомоцию (idle/бег), чтобы ноги не бежали
			-- на месте поверх эмоции; ядро и чужие Action не трогаем
			pcall(function()
				for _, t in pairs(hum:GetPlayingAnimationTracks()) do
					pcall(function()
						local pr = t.Priority
						if pr == Enum.AnimationPriority.Idle or pr == Enum.AnimationPriority.Movement then
							t:Stop(0.1)
						end
					end)
				end
			end)
			local animator = hum:FindFirstChildOfClass("Animator")
			if not animator then return nil end
			local an = Instance.new("Animation")
			an.AnimationId = "rbxassetid://" .. tostring(id)
			local ok, tr = pcall(function() return animator:LoadAnimation(an) end)
			pcall(function() an:Destroy() end)
			if not ok or not tr then return nil end
			tr.Priority = Enum.AnimationPriority.Action
			tr.Looped = true
			local okP = pcall(function() tr:Play(0.1, 1, 1) end)
			if not okP then return nil end
			-- честная проверка: у приватных/удалённых ассетов Length=0 и трек не играет
			local t0 = os.clock()
			while os.clock() - t0 < 2 do
				local ready = false
				pcall(function() ready = tr.IsPlaying and tr.Length > 0 end)
				if ready then break end
				task.wait(0.15)
			end
			local good = false
			pcall(function() good = tr.IsPlaying and tr.Length > 0 end)
			if not good then pcall(function() tr:Stop() end) return nil end
			return tr
		end
		local tr = nil
		pcall(function() tr = startTrack() end)
		if not tr then log("emote failed (asset blocked?): " .. tostring(label)) return end
		currentEmoteTrack = tr
		-- сторож: если трек умер (смена состояния, Animate, просадка),
		-- молча поднимаем заново тот же id
		WGT.spawn(function()
			while WGT.isAlive() do
				task.wait(0.5)
				if gen ~= emoGen then break end
				if lastEmoId ~= id then break end
				local alive = false
				pcall(function()
					alive = currentEmoteTrack ~= nil and currentEmoteTrack.IsPlaying
				end)
				if not alive then
					local ntr = nil
					pcall(function() ntr = startTrack() end)
					if ntr then currentEmoteTrack = ntr end
				end
			end
		end)
		log("emote: " .. tostring(label))
	end
	local function animGetAnimate()
		local ch = plr.Character
		if not ch then return nil end
		return ch:FindFirstChild("Animate") or ch:WaitForChild("Animate", 3)
	end
	local function animSaveDefault(anim)
		-- БЫЛО: animDefaults[key] = id по строковому ключу И НИКАКОГО кода отката:
		-- пак переписывал AnimationId в Animate навсегда, вернуть было нечем.
		for _, e in ipairs(animDefaults) do
			if e.anim == anim then return end
		end
		table.insert(animDefaults, {anim = anim, id = anim.AnimationId})
	end
	local function animRestoreDefaults()
		local n = 0
		for _, e in ipairs(animDefaults) do
			if e.anim and e.anim.Parent then
				if pcall(function() e.anim.AnimationId = e.id end) then n += 1 end
			end
		end
		table.clear(animDefaults)
		currentPackId = nil
		return n
	end
	local function animSetId(animate, parentName, childVariants, id)
		local url = "rbxassetid://" .. tostring(id)
		local parent = animate:FindFirstChild(parentName)
		if not parent then return false end
		local hit = false
		for _, cn in ipairs(childVariants) do
			local a = parent:FindFirstChild(cn)
			if a and a:IsA("Animation") then animSaveDefault(a) a.AnimationId = url hit = true end
		end
		if not hit then
			for _, d in pairs(parent:GetDescendants()) do
				if d:IsA("Animation") then animSaveDefault(d) d.AnimationId = url hit = true end
			end
		end
		return hit
	end
	local function animStopTracks()
		local ch = plr.Character
		local hum = ch and ch:FindFirstChildOfClass("Humanoid")
		if hum then
			for _, t in pairs(hum:GetPlayingAnimationTracks()) do
				pcall(function() t:Stop() end)
			end
		end
	end
	local function classifySlot(name)
		local n = string.lower(name or "")
		if n == "" then return nil end
		if string.find(n, "swim", 1, true) then
			return string.find(n, "idle", 1, true) and "swimidle" or "swim"
		elseif string.find(n, "walk", 1, true) then return "walk"
		elseif string.find(n, "run", 1, true) then return "run"
		elseif string.find(n, "jump", 1, true) then return "jump"
		elseif string.find(n, "fall", 1, true) then return "fall"
		elseif string.find(n, "climb", 1, true) then return "climb"
		elseif string.find(n, "idle", 1, true) then return "idle" end
		return nil
	end
	local function resolveAnimId(assetId)
		local ok, objs = pcall(function() return game:GetObjects("rbxassetid://" .. tostring(assetId)) end)
		if not ok or type(objs) ~= "table" then return nil end
		local found = nil
		local function scan(obj)
			if found then return end
			if obj:IsA("Animation") then
				local n = tonumber(string.match(obj.AnimationId or "", "%d+"))
				if n and n > 0 then found = n return end
			end
			for _, c in pairs(obj:GetChildren()) do scan(c) if found then return end end
		end
		for _, o in ipairs(objs) do
			scan(o)
			pcall(function() o:Destroy() end)
		end
		return found
	end
	local packBusy = false
	local function applyPackById(bid, label, bundle)
		if packBusy then log("busy, wait...") return end
		packBusy = true
		WGT.spawn(function()
			local ok, err = pcall(function()
				log("resolving " .. tostring(label) .. "...")
				local map = packCache[bid]
				if not map then
					map = {}
					local cands = {}
					local detOk, det = pcall(function() return AssetSvc:GetBundleDetailsAsync(bid) end)
					if detOk and det and det.Items then
						for _, it in pairs(det.Items) do
							if it.Id then table.insert(cands, {id = it.Id, name = it.Name}) end
						end
					end
					if #cands == 0 and type(bundle) == "table" then
						local MPS = game:GetService("MarketplaceService")
						for _, arr in pairs(bundle) do
							for _, aid in pairs(arr) do
								local aidN = tonumber(aid)
								if aidN then
									local nm = nil
									local iOk, info = pcall(function() return MPS:GetProductInfo(aidN) end)
									if iOk and info then nm = info.Name end
									table.insert(cands, {id = aidN, name = nm})
								end
							end
						end
					end
					local good, bad = 0, 0
					for _, c in ipairs(cands) do
						local slot = classifySlot(c.name)
						if slot and not map[slot] then
							local rid = resolveAnimId(c.id)
							if rid then map[slot] = rid good += 1
							else bad += 1 end
						end
					end
					packCache[bid] = map
					log("checked: " .. tostring(good) .. " ok, " .. tostring(bad) .. " broken skipped")
				end
				local cnt = 0
				for _ in pairs(map) do cnt += 1 end
				if cnt == 0 then log("resolve failed: no anims") packBusy = false return end
				log("mapped " .. tostring(cnt) .. "/7, applying...")
				local animate = animGetAnimate()
				if not animate then log("no Animate found") packBusy = false return end
				local applied = 0
				if map.idle then if animSetId(animate, "idle", {"Animation1", "Animation2", "IdleAnim"}, map.idle) then applied += 1 end end
				if map.walk then if animSetId(animate, "walk", {"WalkAnim"}, map.walk) then applied += 1 end end
				if map.run then if animSetId(animate, "run", {"RunAnim"}, map.run) then applied += 1 end end
				if map.jump then if animSetId(animate, "jump", {"JumpAnim"}, map.jump) then applied += 1 end end
				if map.fall then if animSetId(animate, "fall", {"FallAnim"}, map.fall) then applied += 1 end end
				if map.climb then if animSetId(animate, "climb", {"ClimbAnim"}, map.climb) then applied += 1 end end
				if map.swim then if animSetId(animate, "swim", {"Swim"}, map.swim) then applied += 1 end end
				if map.swimidle then if animSetId(animate, "swimidle", {"SwimIdle"}, map.swimidle) then applied += 1 end end
				if applied == 0 then log("apply failed: no slots") packBusy = false return end
				animStopTracks()
				local hum = plr.Character and plr.Character:FindFirstChildOfClass("Humanoid")
				if hum then pcall(function() hum:ChangeState(Enum.HumanoidStateType.Jumping) end) end
				currentPackId = bid
				log("pack applied (" .. tostring(applied) .. "): " .. tostring(label))
				packBusy = false
			end)
			if not ok then log("pack error") packBusy = false end
		end)
	end
