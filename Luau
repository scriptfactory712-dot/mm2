	local wearCache = {}
	local function resolveWear(assetId, className, prop)
		local key = tostring(assetId)
		if wearCache[key] ~= nil then return wearCache[key] end
		local out = nil
		pcall(function()
			local objs = game:GetObjects("rbxassetid://" .. key)
			if type(objs) == "table" then
				for _, o in ipairs(objs) do
					local inst = nil
					if o:IsA(className) then inst = o
					else pcall(function() inst = o:FindFirstChildWhichIsA(className, true) end) end
					if inst and inst[prop] then out = inst[prop] break end
				end
				for _, o in ipairs(objs) do pcall(function() o:Destroy() end) end
			end
		end)
		wearCache[key] = out
		return out
	end
