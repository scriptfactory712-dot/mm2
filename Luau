WGT.styleCustom = function(object)
	if object:IsA("TextLabel") or object:IsA("TextButton") or object:IsA("TextBox") then
		if object.Font == Enum.Font.Code then object.Font = Enum.Font.Gotham end
	elseif object:IsA("UICorner") then
		local radius = object.CornerRadius
		if radius.Scale == 0 and radius.Offset > 0 and radius.Offset <= 3 then object.CornerRadius = UDim.new(0, 8) end
	end
end

