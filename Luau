		if spot then
			hrp.CFrame = spot
			hrp.AssemblyLinearVelocity = Vector3.zero
			hrp.AssemblyAngularVelocity = Vector3.zero
		else
			log("no spot saved")
		end
	end)
	-- Safe spot: точных координат сейфов под каждую карту в открытом виде нет
	-- (в гайдах только описания: "шкаф в Bank 2", "балкон в Beach Resort"),
	-- а пул карт меняется. Поэтому ищем самую высокую твёрдую поверхность
	-- текущей карты динамически — работает на любой карте, включая новые.
	btn(PG.tp, "safe spot (top)", function()
		local hrp = plr.Character and plr.Character:FindFirstChild("HumanoidRootPart")
		if not hrp then return end
		local map = WGT.findMap()
		if not map or map == "None" then log("map not found") return end
		local ch = plr.Character
		local best, bestScore = nil, -1e9
		for _, d in pairs(map:GetDescendants()) do
			if d:IsA("BasePart") and not d:IsDescendantOf(ch) then
				local s = d.Size
				if math.min(s.X, s.Z) >= 3 then
					local topY = d.Position.Y + s.Y / 2
					-- твёрдые детали в приоритете (+1000), чтобы не кидало на декор
					local score = topY + (d.CanCollide and 1000 or 0)
					if score > bestScore and (d.Position - hrp.Position).Magnitude < 600 then
						bestScore = score best = d
					end
				end
			end
		end
		if best then
			hrp.CFrame = CFrame.new(best.Position + Vector3.new(0, best.Size.Y / 2 + 4, 0))
			hrp.AssemblyLinearVelocity = Vector3.zero
			hrp.AssemblyAngularVelocity = Vector3.zero
			log("safe: " .. map.Name)
		else
			log("no spot found")
		end
	end)
	btn(PG.tp, "current map", function()
		local map = WGT.findMap()
		if not map or map == "None" then log("lobby / no map") return end
		log("map: " .. map.Name .. " (" .. tostring(map:GetAttribute("MapID")) .. ")")
	end)
	local list = Instance.new("Frame") list.Size = UDim2.new(1,0,0,0) list.AutomaticSize = Enum.AutomaticSize.Y list.BackgroundTransparency = 1 list.Parent = PG.tp
	local ll = Instance.new("UIListLayout") ll.Padding = UDim.new(0,4) ll.Parent = list
	local function rebuild()
		for _, v in pairs(list:GetChildren()) do if v:IsA("TextButton") then v:Destroy() end end
		for _, p in pairs(Players:GetPlayers()) do
			if p ~= plr then
				local b = Instance.new("TextButton")
				b.Size = UDim2.new(1,0,0,26)
				b.BackgroundColor3 = BTN
				b.BorderSizePixel = 0
				b.Font = Enum.Font.Code
				b.TextSize = 11
				b.TextColor3 = TXT
				b.Text = "tp -> " .. p.Name
				b.Parent = list
				local cc = Instance.new("UICorner") cc.CornerRadius = UDim.new(0,4) cc.Parent = b
				b.MouseButton1Click:Connect(function()
					local a = plr.Character and plr.Character:FindFirstChild("HumanoidRootPart")
					local t = p.Character and p.Character:FindFirstChild("HumanoidRootPart")
					if a and t then a.CFrame = t.CFrame + Vector3.new(0,0,3) end
				end)
			end
		end
	end
	rebuild()
	-- keep(): без этого после unload rebuild() продолжал дёргаться при заходе
	-- нового игрока и падал на разрушенном PG.tp
	keep(Players.PlayerAdded:Connect(rebuild)) keep(Players.PlayerRemoving:Connect(rebuild))
end

