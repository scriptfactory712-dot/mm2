do
	-- Ищем спавн лобби: спавны карты лежат внутри модели карты (MapID),
	-- лобби — снаружи. Если ничего не нашли — возвращаем nil и НЕ телепортируем
	-- (раньше кидало в CFrame.new(0,20,0) — пустое небо, "космос").
	local function lobbyCFrame()
		local map = nil
		pcall(function() map = WGT.findMap() end)
		local fallback = nil
		for _, s in pairs(workspace:GetDescendants()) do
			if s:IsA("SpawnLocation") and s.Enabled then
				local cf = s.CFrame + Vector3.new(0, 5, 0)
				if not map or map == "None" or not s:IsDescendantOf(map) then
					return cf
				elseif not fallback then
					fallback = cf
				end
			end
		end
		return fallback
	end
	local function tpLobby()
		local hrp = plr.Character and plr.Character:FindFirstChild("HumanoidRootPart")
		if not hrp then return end
		local cf = lobbyCFrame()
		if cf then
			hrp.CFrame = cf
			hrp.AssemblyLinearVelocity = Vector3.zero
			hrp.AssemblyAngularVelocity = Vector3.zero
		else
			log("lobby spawn not found")
		end
	end
	btn(PG.tp, "to spawn", function() tpLobby() end)
	btn(PG.tp, "Tp Lobby", function() tpLobby() end)
	btn(PG.tp, "Tp Murderer", function()
		local hrp = plr.Character and plr.Character:FindFirstChild("HumanoidRootPart")
		local m = findMurderSheriff()
		local t = m and m.Character and m.Character:FindFirstChild("HumanoidRootPart")
