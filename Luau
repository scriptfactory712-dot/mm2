			if g:IsA("BasePart") then pos = g.Position
			elseif g:IsA("Model") then pos = g:GetPivot().Position
			else
				local h = g:FindFirstChild("Handle", true)
				if h and h:IsA("BasePart") then pos = h.Position end
			end
		end)
