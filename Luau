-- noclip запоминает ИСХОДНЫЕ CanCollide: раньше при выключении фарма всем
-- подряд ставилось CanCollide = true, включая изначально неколлайдные части
-- (триггеры, монеты, хитбоксы) -> ломалась карта.
-- noclip: saved[part] = исходный CanCollide, mode = false|"clear"
local noclipSaved = {}
local function noclipApply(part, off)
	if not (part and part.Parent) then return end
	WGT.remember(part, "CanCollide")
	if noclipSaved[part] == nil then noclipSaved[part] = part.CanCollide end
	if off and part.CanCollide then part.CanCollide = false end
end
local function noclipRestore()
	for part, was in pairs(noclipSaved) do
		if part and part.Parent then pcall(function() part.CanCollide = was end) end
	end
	table.clear(noclipSaved)
end
local function farmNoclip(enabled)
	local ch = plr.Character
	local hrp = ch and ch:FindFirstChild("HumanoidRootPart")
	if not hrp then
		if not enabled then noclipRestore() farmNoclipOn = false end
		return
	end
	if not enabled then
		noclipRestore()
		farmNoclipOn = false
		return
	end
	for _, part in pairs(ch:GetDescendants()) do
		if part:IsA("BasePart") then noclipApply(part, true) end
	end
	-- GetDescendants по всему workspace - дорого; берём только BasePart
	for _, obj in pairs(workspace:GetDescendants()) do
		if obj:IsA("BasePart") and not obj:IsDescendantOf(ch) then
			if (hrp.Position - obj.Position).Magnitude < farmNoclipRadius then
				noclipApply(obj, true)
			end
		end
	end
	farmNoclipOn = true
end
local function farmFly(on)
	if on and not WGT.isAlive() then return end
	local ch = plr.Character
	if not ch then return end
	local hum = ch:FindFirstChildOfClass("Humanoid")
	local hrp = ch:FindFirstChild("HumanoidRootPart")
	if not hum or not hrp then return end
	if on then
		hum:SetStateEnabled(Enum.HumanoidStateType.Jumping, false)
		hum:SetStateEnabled(Enum.HumanoidStateType.FallingDown, false)
		hum.PlatformStand = true
		-- БЫЛО: если farmBodyvel уже есть, новый НЕ создавался -> после респавна
		-- он оставался на старом HRP и фарм молча стоял на месте.
		if farmBodyVel and farmBodyVel.Parent ~= hrp then
			pcall(function() farmBodyVel:Destroy() end)
			farmBodyVel = nil
		end
		if not farmBodyVel then
			farmBodyVel = Instance.new("BodyVelocity")
			farmBodyVel.MaxForce = Vector3.new(1e8, 1e8, 1e8)
			farmBodyVel.Parent = hrp
		end
	else
		hum:SetStateEnabled(Enum.HumanoidStateType.Jumping, true)
		hum:SetStateEnabled(Enum.HumanoidStateType.FallingDown, true)
		hum.PlatformStand = false
		if farmBodyVel then
			pcall(function() farmBodyVel:Destroy() end)
			farmBodyVel = nil
		end
	end
end
