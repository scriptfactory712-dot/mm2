	KF.touchBtn.Parent = PG.mm2
	local wcorner = Instance.new("UICorner")
	wcorner.CornerRadius = UDim.new(0, 8)
	wcorner.Parent = KF.touchBtn
	KF.touchBtn.MouseButton1Click:Connect(function() safe(function() KF.setTouch(not KF.touch) end) end)

	-- STOP гасит оба флинга + страховочно гасит Assembly-скорости
	-- (старый stop знал только deprecated Velocity и выходил раньше времени).
	KF._oldStop = KF.stop
	KF.stop = function()
		pcall(function() if KF.setTouch and KF.touch then KF.setTouch(false) end end)
		KF._oldStop()
		pcall(function()
			local c = plr.Character
			local h = c and c:FindFirstChildOfClass("Humanoid")
			local r = h and h.RootPart
			if r and r.Parent then
				r.AssemblyLinearVelocity = Vector3.zero
				r.AssemblyAngularVelocity = Vector3.zero
			end
		end)
	end
	WGT.kfStop = KF.stop

	keep(plr.CharacterAdded:Connect(function()
		if not WGT.isAlive() then return end
		KF.oldPos = nil
		KF.refresh()
